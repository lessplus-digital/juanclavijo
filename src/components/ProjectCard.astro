---
import type { CollectionEntry } from 'astro:content';
import ProjectArt from '@/components/ProjectArt.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const p = project.data;
const href = `/proyectos/${project.id}/`;
---

<article
  class:list={['pc', p.featured && 'pc--big']}
  style={`--accent: var(--${p.accent})`}
  data-reveal="scale"
  data-tilt
>
  <a class="pc__hit" href={href} aria-label={`Ver el proyecto ${p.title}`}></a>

  <div class="pc__art">
    {
      p.cover ? (
        <img src={p.cover} alt="" width="900" height="600" loading="lazy" decoding="async" />
      ) : (
        <ProjectArt variant={index} />
      )
    }
    <span class="pc__badge mono-num">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="pc__body">
    <p class="pc__kicker">{p.kicker}</p>
    <h3 class="pc__title">{p.title}</h3>
    <p class="pc__summary">{p.summary}</p>

    {
      p.metrics.length > 0 && (
        <ul class="pc__metrics">
          {p.metrics.slice(0, 3).map((m) => (
            <li>
              <b class="mono-num">{m.value}</b>
              <span>{m.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="pc__foot">
      <ul class="pc__tags">
        {p.tags.slice(0, 4).map((t) => <li class="chip">{t}</li>)}
      </ul>
      <span class="pc__go">
        <span>Ver caso</span>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path
            d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </span>
    </div>
  </div>
</article>

<style>
  .pc {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--bg-2) 74%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    overflow: hidden;
    isolation: isolate;
    transform-style: preserve-3d;
    transition: border-color 0.5s var(--ease-out), box-shadow 0.6s var(--ease-out),
      transform 0.5s var(--ease-out);
  }

  .pc::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 0%),
      color-mix(in oklab, var(--accent) 16%, transparent),
      transparent 62%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .pc:hover,
  .pc:focus-within {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    box-shadow: var(--shadow-lift);
  }
  .pc:hover::after,
  .pc:focus-within::after {
    opacity: 1;
  }

  .pc__hit {
    position: absolute;
    inset: 0;
    z-index: 4;
  }

  /* Panel de arte */
  .pc__art {
    position: relative;
    aspect-ratio: 16 / 10;
    background: color-mix(in oklab, var(--accent) 9%, var(--bg-3));
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .pc__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out), filter 0.6s var(--ease-out);
  }
  .pc:hover .pc__art img {
    transform: scale(1.05);
  }

  .pc__badge {
    position: absolute;
    top: 0.9rem;
    left: 1rem;
    z-index: 2;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--accent) 82%, var(--ink));
  }

  /* Contenido */
  .pc__body {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: clamp(1.3rem, 3vw, 2.1rem);
  }

  .pc__kicker {
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 78%, var(--ink-3));
  }

  .pc__title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }

  .pc__summary {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 52ch;
  }

  .pc__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 0.9rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .pc__metrics li {
    display: grid;
    gap: 0.1rem;
  }
  .pc__metrics b {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
    font-variation-settings: 'opsz' 100, var(--wonk-on);
  }
  .pc__metrics span {
    font-size: var(--step--2);
    color: var(--ink-3);
    max-width: 18ch;
    line-height: 1.3;
  }

  .pc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.2rem;
  }

  .pc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pc__go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
    white-space: nowrap;
  }
  .pc__go svg {
    transition: transform 0.5s var(--ease-spring);
  }
  .pc:hover .pc__go svg {
    transform: translate(3px, -3px);
  }
  .pc__go::before {
    content: '';
    width: 26px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0.35);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }
  .pc:hover .pc__go::before {
    transform: scaleX(1);
  }

  /* Tarjeta destacada: arte y texto lado a lado */
  @media (min-width: 860px) {
    .pc--big {
      grid-column: 1 / -1;
      grid-template-rows: none;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: stretch;
    }
    .pc--big .pc__art {
      aspect-ratio: auto;
      min-height: 340px;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .pc--big .pc__body {
      align-content: center;
      padding: clamp(2rem, 3.4vw, 3.2rem);
    }
    .pc--big .pc__title {
      font-size: var(--step-4);
    }
    .pc--big .pc__summary {
      font-size: var(--step-0);
    }
    /* Alterna el lado del arte para que la retícula no sea monótona */
    .pc--big:nth-of-type(even) .pc__art {
      order: 2;
      border-right: 0;
      border-left: 1px solid var(--line);
    }
  }
</style>

<script>
  // ── Inclinación 3D y foco de luz que sigue al puntero ─────────────────────
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;

  if (!reduce && fine) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      const max = 4.5;

      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
        card.style.transform = `perspective(1100px) rotateX(${(0.5 - py) * max}deg) rotateY(${
          (px - 0.5) * max
        }deg) translateY(-4px)`;
      });

      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>
