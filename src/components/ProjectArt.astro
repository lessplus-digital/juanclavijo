---
interface Props {
  /** Elige la composición (0-3). Se reparte por el orden del proyecto. */
  variant?: number;
  class?: string;
}
const { variant = 0, class: cls } = Astro.props;
const v = ((variant % 4) + 4) % 4;

// Datos precalculados en el servidor: el SVG sale ya dibujado, sin JS.
const rings = Array.from({ length: 9 }, (_, i) => ({
  r: 18 + i * 21,
  o: (1 - i / 11).toFixed(2),
  dx: i * 7,
}));

const waves = Array.from({ length: 11 }, (_, i) => {
  const y = 30 + i * 24;
  const amp = 10 + (i % 4) * 9;
  const d = `M-10 ${y} C 90 ${y - amp}, 170 ${y + amp}, 260 ${y - amp / 2} S 400 ${y + amp}, 470 ${y}`;
  return { d, o: (0.22 + (i % 5) * 0.16).toFixed(2) };
});

const dots = Array.from({ length: 13 * 10 }, (_, i) => {
  const col = i % 13;
  const row = Math.floor(i / 13);
  const cx = 22 + col * 30;
  const cy = 20 + row * 30;
  const dist = Math.hypot(cx - 250, cy - 130) / 250;
  return { cx, cy, r: Math.max(1.1, 9.5 * (1 - dist)) };
});

const squares = Array.from({ length: 8 }, (_, i) => ({
  s: 250 - i * 28,
  rot: i * 9,
  o: (1 - i / 10).toFixed(2),
}));
---

<div class:list={['art', cls]} data-v={v} aria-hidden="true">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
    {
      v === 0 && (
        <g class="a-rings" fill="none" stroke="currentColor" stroke-width="1.4">
          {rings.map((c) => (
            <circle cx={200 + c.dx} cy="150" r={c.r} opacity={c.o} />
          ))}
        </g>
      )
    }

    {
      v === 1 && (
        <g class="a-waves" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
          {waves.map((w) => (
            <path d={w.d} opacity={w.o} />
          ))}
        </g>
      )
    }

    {
      v === 2 && (
        <g class="a-dots" fill="currentColor">
          {dots.map((d) => (
            <circle cx={d.cx} cy={d.cy} r={d.r} />
          ))}
        </g>
      )
    }

    {
      v === 3 && (
        <g class="a-sq" fill="none" stroke="currentColor" stroke-width="1.4">
          {squares.map((s) => (
            <rect
              x={200 - s.s / 2}
              y={150 - s.s / 2}
              width={s.s}
              height={s.s}
              rx={s.s * 0.22}
              opacity={s.o}
              transform={`rotate(${s.rot} 200 150)`}
            />
          ))}
        </g>
      )
    }
  </svg>
</div>

<style>
  .art {
    position: absolute;
    inset: 0;
    color: var(--accent, var(--c1));
    overflow: hidden;
  }
  .art svg {
    width: 100%;
    height: 100%;
    opacity: 0.85;
  }

  .a-rings {
    transform-origin: 200px 150px;
    animation: art-breathe 12s var(--ease-io) infinite alternate;
  }
  .a-waves {
    animation: art-slide 16s var(--ease-io) infinite alternate;
  }
  .a-dots {
    transform-origin: 250px 130px;
    animation: art-breathe 14s var(--ease-io) infinite alternate-reverse;
  }
  .a-sq {
    transform-origin: 200px 150px;
    animation: art-turn 30s linear infinite;
  }

  @keyframes art-breathe {
    to {
      transform: scale(1.14) translate(-8px, 6px);
    }
  }
  @keyframes art-slide {
    to {
      transform: translate(-46px, 10px);
    }
  }
  @keyframes art-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art g {
      animation: none;
    }
  }
</style>
