---
/**
 * Fila grande del portafolio: la maqueta animada a un lado, el texto al otro.
 * Solo la usan los proyectos con `layout: scene`.
 *
 * NO HAY PÁGINA DE DETALLE. La escena y el título apuntan al sitio real del
 * proyecto, en una pestaña nueva. Todo lo que se cuenta del caso cabe aquí.
 *
 * POR QUÉ ES UNA FILA Y NO UNA TARJETA CON MARCO
 * La escena vive sobre un lienzo de proporción fija (10/8). Dentro de una
 * tarjeta con borde común, la retícula estira la columna del arte hasta la
 * altura del texto y esa proporción se rompe: la maqueta quedaba recortada por
 * arriba y por abajo a ciertos anchos. Al separar los dos bloques, el panel
 * conserva su proporción siempre y el texto crece por su cuenta.
 *
 * El lado del arte alterna por fila (`.pj--flip` en las impares), que es lo que
 * evita que cuatro proyectos seguidos se lean como una lista.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectScene from '@/components/ProjectScene.astro';
import Pin from '@/components/Pin.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}
const { project, index } = Astro.props;
const p = project.data;
const num = String(index + 1).padStart(2, '0');
const flip = index % 2 === 1;

/** Atributos del enlace externo, idénticos en los tres sitios donde se repite. */
const out = { href: p.url, target: '_blank', rel: 'noreferrer' } as const;
---

<article
  class:list={['pj', flip && 'pj--flip']}
  style={`--accent: var(--${p.accent})`}
  data-reveal
  data-pj
>
  <!-- La escena es decorativa y duplica el enlace del título: fuera del orden
       de tabulación para no obligar a pasar dos veces por lo mismo. -->
  <a class="pj__art" {...out} tabindex="-1" aria-hidden="true">
    <ProjectScene scene={p.scene!} />
    <span class="pj__open">
      Abrir sitio
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path
          d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>

  <div class="pj__body">
    <p class="pj__kicker">
      <span class="mono-num">{num}</span>{p.kicker}
      <span class="pj__place"><Pin />{p.country}</span>
    </p>

    <h3 class="pj__title">
      <a {...out}>{p.title}</a>
    </h3>

    <p class="pj__summary">{p.summary}</p>

    {
      p.highlights.length > 0 && (
        <ul class="pj__points">
          {p.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }

    {
      p.metrics.length > 0 && (
        <ul class="pj__metrics">
          {p.metrics.slice(0, 3).map((m) => (
            <li>
              <b class="mono-num">{m.value}</b>
              <span>{m.label}</span>
            </li>
          ))}
        </ul>
      )
    }

    <ul class="pj__tags">
      {p.tags.slice(0, 5).map((t) => <li class="chip">{t}</li>)}
    </ul>

    <div class="pj__foot">
      <a class="pj__link" {...out}>
        <span>{p.urlLabel}</span>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path
            d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <p class="pj__meta">{p.role} · {p.year}</p>
    </div>
  </div>
</article>

<style>
  .pj {
    display: grid;
    gap: clamp(1.5rem, 3.4vw, 3.4rem);
    align-items: center;
  }

  /* ── Panel de la escena ─────────────────────────────────────────────── */
  .pj__art {
    position: relative;
    display: block;
    /* Proporción del lienzo de las escenas. No la cambies sin cambiar el
       lienzo de ProjectScene: la maqueta se recortaría. */
    aspect-ratio: 10 / 8;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--bg-3);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    isolation: isolate;
    transition: border-color 0.6s var(--ease-out), box-shadow 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
  }

  .pj__art::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--accent) 40%, transparent);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }

  .pj:hover .pj__art,
  .pj:focus-within .pj__art {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    box-shadow: var(--shadow-lift);
    transform: translateY(-6px);
  }
  .pj:hover .pj__art::after,
  .pj:focus-within .pj__art::after {
    opacity: 1;
  }

  .pj__open {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.6rem);
    transition: opacity 0.45s var(--ease-out), transform 0.55s var(--ease-spring);
  }
  .pj:hover .pj__open,
  .pj:focus-within .pj__open {
    opacity: 1;
    transform: none;
  }

  /* Sin puntero no hay hover: en táctil la píldora se queda puesta, que si no
     el panel no anuncia por ningún lado que se puede tocar. */
  @media (hover: none) {
    .pj__open {
      opacity: 1;
      transform: none;
    }
  }

  /* ── Texto ──────────────────────────────────────────────────────────── */
  .pj__body {
    display: grid;
    align-content: center;
    gap: 0.55rem;
  }

  .pj__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 80%, var(--ink-3));
  }
  /* El país va al final de la línea del epígrafe: es un dato de ficha, no un
     titular, pero el cliente lo busca. */
  .pj__place {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.2rem 0.6rem 0.2rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .pj__kicker .mono-num {
    padding-right: 0.7rem;
    border-right: 1px solid var(--line-strong);
    color: var(--ink-3);
  }

  .pj__title {
    font-size: var(--step-4);
    letter-spacing: -0.038em;
    line-height: 1.02;
  }
  .pj__title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 0% 2px;
    transition: background-size 0.55s var(--ease-out);
  }
  .pj:hover .pj__title a,
  .pj__title a:focus-visible {
    background-size: 100% 2px;
  }

  .pj__summary {
    margin-top: 0.15rem;
    font-size: var(--step-0);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .pj__points {
    display: grid;
    gap: 0.42rem;
    margin-top: 0.7rem;
    padding: 0;
    list-style: none;
    max-width: 48ch;
  }
  .pj__points li {
    position: relative;
    padding-left: 1.15rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .pj__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .pj__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    margin: 1.1rem 0 0;
    padding: 1.05rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .pj__metrics li {
    display: grid;
    gap: 0.1rem;
  }
  .pj__metrics b {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--display-weight);
    font-variation-settings: var(--display-fvs);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .pj__metrics span {
    font-size: var(--step--2);
    color: var(--ink-3);
    max-width: 17ch;
    line-height: 1.3;
  }

  .pj__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
    padding: 0;
    list-style: none;
  }

  .pj__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 1.1rem;
  }

  .pj__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-alt);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .pj__link::before {
    content: '';
    width: 28px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0.35);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }
  .pj:hover .pj__link::before {
    transform: scaleX(1);
  }
  .pj__link svg {
    transition: transform 0.5s var(--ease-spring);
  }
  .pj:hover .pj__link svg {
    transform: translate(3px, -3px);
  }

  .pj__meta {
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  /* ── Dos columnas, alternando el lado ───────────────────────────────── */
  @media (min-width: 1040px) {
    .pj {
      /* La columna del arte va algo más ancha: es la pieza que manda. */
      grid-template-columns: 1.12fr 1fr;
    }
    /* Al invertir el lado hay que invertir también el reparto, o la fila impar
       pintaría la maqueta en la columna estrecha y las dos filas saldrían con
       la escena de distinto tamaño. */
    .pj--flip {
      grid-template-columns: 1fr 1.12fr;
    }
    .pj--flip .pj__art {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pj__art,
    .pj__open {
      transition: none;
    }
    .pj:hover .pj__art {
      transform: none;
    }
  }
</style>
