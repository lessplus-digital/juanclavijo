---
/**
 * Tarjeta compacta del portafolio: la captura del sitio y poco más.
 * La usan los proyectos con `layout: shot`, que van de dos en dos.
 *
 * POR QUÉ AQUÍ NO HAY MAQUETA NI ANIMACIÓN
 * Estos son sitios terminados: no «hacen» nada que se pueda contar en un bucle.
 * Meterlos en un marco de navegador con brillos y paneos era decorar por
 * decorar, y además competía con las dos filas grandes, que sí tienen algo que
 * enseñar. La captura sola, grande y quieta, dice más.
 *
 * Tampoco llevan cifras: los números que tenían eran de relleno. Si algún día
 * hay un dato real, se añade `metrics` al .md y se pinta como en ProjectRow.
 *
 * `solo` es para cuando queda una única captura: la tarjeta se abre en fila,
 * captura a un lado y texto al otro. Una tarjeta compacta sola dejaría medio
 * ancho vacío a su derecha.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Pin from '@/components/Pin.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  /** Única captura del grupo: se pinta como fila en vez de tarjeta. */
  solo?: boolean;
}
const { project, index, solo = false } = Astro.props;
const p = project.data;
const num = String(index + 1).padStart(2, '0');

const out = { href: p.url, target: '_blank', rel: 'noreferrer' } as const;
---

<article
  class:list={['ps', solo && 'ps--solo']}
  style={`--accent: var(--${p.accent})`}
  data-reveal
>
  <!-- Decorativo: duplica el enlace del título, así que fuera del orden de
       tabulación para no obligar a pasar dos veces por lo mismo. -->
  <a class="ps__art" {...out} tabindex="-1" aria-hidden="true">
    {p.shot && <Image src={p.shot} width={1200} alt="" loading="lazy" />}
    <span class="ps__open">
      Abrir sitio
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
        <path
          d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </a>

  <div class="ps__body">
    <p class="ps__kicker">
      <span class="mono-num">{num}</span>{p.kicker}
      <span class="ps__place"><Pin />{p.country}</span>
    </p>

    <h3 class="ps__title"><a {...out}>{p.title}</a></h3>

    <p class="ps__summary">{p.summary}</p>

    {
      p.highlights.length > 0 && (
        <ul class="ps__points">
          {p.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      )
    }

    <ul class="ps__tags">
      {p.tags.slice(0, 4).map((t) => <li class="chip">{t}</li>)}
    </ul>

    <div class="ps__foot">
      <a class="ps__link" {...out}>
        <span>{p.urlLabel}</span>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path
            d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <p class="ps__meta">{p.role} · {p.year}</p>
    </div>
  </div>
</article>

<style>
  .ps {
    display: grid;
    align-content: start;
    gap: 1.4rem;
  }

  /* Una sola captura: fila de dos columnas, con la imagen algo más ancha —
     el mismo reparto que las filas grandes, para que no se lean como cosas
     distintas. */
  @media (min-width: 900px) {
    .ps--solo {
      grid-template-columns: 1.12fr 1fr;
      gap: clamp(1.8rem, 3.4vw, 3.4rem);
      align-items: center;
      align-content: center;
    }
  }

  .ps__art {
    position: relative;
    display: block;
    /* La proporción de las capturas (~2.04). Recorta un pelo y no se come ni
       el logotipo ni el botón de contacto, que viven pegados a los bordes. */
    aspect-ratio: 2 / 1;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-3);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
    transition: border-color 0.6s var(--ease-out), box-shadow 0.7s var(--ease-out),
      transform 0.7s var(--ease-out);
  }
  /* El <img> lo pinta <Image />, que es un componente: los estilos con ámbito
     no le llegan por clase. Se le entra desde el envoltorio. */
  .ps__art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .ps:hover .ps__art,
  .ps:focus-within .ps__art {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    box-shadow: var(--shadow-lift);
    transform: translateY(-6px);
  }

  .ps__open {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.03em;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(0.6rem);
    transition: opacity 0.45s var(--ease-out), transform 0.55s var(--ease-spring);
  }
  .ps:hover .ps__open,
  .ps:focus-within .ps__open {
    opacity: 1;
    transform: none;
  }
  /* Sin puntero no hay hover: en táctil la píldora se queda puesta. */
  @media (hover: none) {
    .ps__open {
      opacity: 1;
      transform: none;
    }
  }

  .ps__body {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .ps__kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--accent) 80%, var(--ink-3));
  }
  .ps__kicker .mono-num {
    padding-right: 0.6rem;
    border-right: 1px solid var(--line-strong);
    color: var(--ink-3);
  }
  .ps__place {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    padding: 0.2rem 0.6rem 0.2rem 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .ps__title {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .ps__title a {
    color: inherit;
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 0% 2px;
    transition: background-size 0.55s var(--ease-out);
  }
  .ps:hover .ps__title a,
  .ps__title a:focus-visible {
    background-size: 100% 2px;
  }

  .ps__summary {
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 50ch;
  }

  .ps__points {
    display: grid;
    gap: 0.38rem;
    margin-top: 0.55rem;
    padding: 0;
    list-style: none;
  }
  .ps__points li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .ps__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .ps__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0;
    list-style: none;
  }

  .ps__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .ps__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-alt);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .ps__link::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0.35);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }
  .ps:hover .ps__link::before {
    transform: scaleX(1);
  }
  .ps__link svg {
    transition: transform 0.5s var(--ease-spring);
  }
  .ps:hover .ps__link svg {
    transform: translate(3px, -3px);
  }

  .ps__meta {
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .ps__art,
    .ps__open {
      transition: none;
    }
    .ps:hover .ps__art {
      transform: none;
    }
  }
</style>
