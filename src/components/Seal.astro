---
import { profile } from '@/config/site';

/**
 * Sello giratorio del héroe.
 * Sin foto → retrato tipográfico abstracto (monograma + formas que respiran).
 * Con foto → la imagen recortada en una forma orgánica dentro del mismo anillo.
 * Se controla con `profile.photo` en src/config/site.ts
 */
const ring = 'DESARROLLADOR FULL STACK · MEDELLÍN → MADRID · ';
---

<figure class="seal" data-cursor="hot">
  <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path
        id="seal-path"
        d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"
        fill="none"></path>
    </defs>
    <text>
      <textPath href="#seal-path" startOffset="0">{ring + ring}</textPath>
    </text>
  </svg>

  <div class="seal__core">
    <span class="blob blob--a" aria-hidden="true"></span>
    <span class="blob blob--b" aria-hidden="true"></span>

    {
      profile.photo ? (
        <img class="seal__photo" src={profile.photo} alt={profile.photoAlt} width="360" height="360" loading="eager" />
      ) : (
        <span class="seal__mono" aria-hidden="true">
          JC
        </span>
      )
    }
  </div>

  <figcaption class="sr-only">{profile.name}, {profile.role}</figcaption>
</figure>

<style>
  .seal {
    position: relative;
    width: min(100%, 340px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    margin: 0;
  }

  /* Anillo de texto */
  .seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spin 34s linear infinite;
  }
  .seal__ring text {
    font-family: var(--font-alt);
    font-size: 9.4px;
    font-weight: 600;
    letter-spacing: 0.32em;
    fill: var(--ink-3);
    text-transform: uppercase;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .seal:hover .seal__ring {
    animation-duration: 12s;
  }

  /* Núcleo */
  .seal__core {
    position: relative;
    width: 68%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    isolation: isolate;
  }

  .blob {
    position: absolute;
    inset: 0;
    border-radius: 62% 38% 44% 56% / 47% 55% 45% 53%;
    filter: blur(2px);
    will-change: border-radius, transform;
  }
  .blob--a {
    background: linear-gradient(150deg, var(--c1), var(--c4));
    animation: morph 14s var(--ease-io) infinite alternate;
    opacity: 0.92;
  }
  .blob--b {
    inset: 12%;
    background: linear-gradient(320deg, var(--c3), var(--c2));
    mix-blend-mode: overlay;
    animation: morph 11s var(--ease-io) infinite alternate-reverse;
    opacity: 0.75;
  }

  @keyframes morph {
    0% {
      border-radius: 62% 38% 44% 56% / 47% 55% 45% 53%;
      transform: rotate(0deg) scale(1);
    }
    50% {
      border-radius: 38% 62% 57% 43% / 62% 38% 62% 38%;
      transform: rotate(-8deg) scale(1.05);
    }
    100% {
      border-radius: 51% 49% 33% 67% / 39% 61% 39% 61%;
      transform: rotate(9deg) scale(0.97);
    }
  }

  .seal__mono {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 4.4rem);
    font-weight: 500;
    font-style: italic;
    letter-spacing: -0.05em;
    color: var(--bg);
    font-variation-settings: 'opsz' 100, 'SOFT' 100, 'WONK' 1;
    mix-blend-mode: hard-light;
    transition: transform 0.8s var(--ease-spring);
  }
  .seal:hover .seal__mono {
    transform: scale(1.07) rotate(-3deg);
  }

  .seal__photo {
    position: relative;
    z-index: 2;
    width: 94%;
    height: 94%;
    object-fit: cover;
    border-radius: 62% 38% 44% 56% / 47% 55% 45% 53%;
    animation: morph 14s var(--ease-io) infinite alternate;
    filter: saturate(1.02) contrast(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .seal__ring,
    .blob,
    .seal__photo {
      animation: none;
    }
  }
</style>
