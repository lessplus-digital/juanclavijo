---
import { profile, sections } from '@/config/site';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Btn from '@/components/Btn.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const links = sections.filter((s) => s.enabled && s.nav);
---

<header class="nav" data-nav>
  <div class="nav__inner shell">
    <a class="brand" href="/" aria-label={`${profile.name}, inicio`}>
      <span class="brand__name">Juan Clavijo<i aria-hidden="true">.</i></span>
      <span class="brand__role">{profile.role}</span>
    </a>

    {
      !compact && (
        <nav class="nav__links" aria-label="Secciones">
          <span class="nav__pill" aria-hidden="true" />

          {links.map((s) => (
            <a href={`/#${s.id}`} data-spy={s.id}>
              {s.nav}
            </a>
          ))}

          {/*
            Copia de las etiquetas en color inverso, recortada exactamente al
            rectángulo de la píldora. El contraste sale de la geometría, así
            que el texto se lee bien también mientras la píldora se desliza.
          */}
          <span class="nav__mask" aria-hidden="true">
            {links.map((s) => (
              <span>{s.nav}</span>
            ))}
          </span>
        </nav>
      )
    }

    <div class="nav__side">
      <ThemeToggle />
      <span class="nav__cta">
        <Btn href="/#contact" label="Hablemos" />
      </span>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-movil">
        <span class="sr-only">Abrir menú</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="menu-movil" hidden>
  <div class="sheet__inner">
    <nav aria-label="Secciones">
      {
        links.map((s, i) => (
          <a href={`/#${s.id}`} style={`--i:${i}`}>
            <em class="mono-num">{s.index}</em>
            <span>{s.nav}</span>
          </a>
        ))
      }
    </nav>

    <div class="sheet__foot" style={`--i:${links.length}`}>
      <Btn href="/#contact" label="Hablemos" />
      <div class="sheet__links">
        <a class="link-u" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="link-u" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding-block: clamp(0.7rem, 1.4vw, 1.05rem);
  }

  /*
    El fondo vive en una capa aparte a la que solo se le anima la opacidad.
    Animar background y backdrop-filter sobre la propia barra era lo que
    producía el tirón al empezar a hacer scroll.
  */
  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--bg) 80%, transparent);
    backdrop-filter: blur(16px) saturate(1.35);
    -webkit-backdrop-filter: blur(16px) saturate(1.35);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out);
    pointer-events: none;
  }
  .nav[data-stuck]::before {
    opacity: 1;
  }

  .nav__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* ── Marca: solo el nombre, sin símbolo ─────────────────────────────── */
  .brand {
    display: grid;
    gap: 0.16rem;
    line-height: 1;
  }
  .brand__name {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.2vw, 1.16rem);
    font-weight: var(--display-weight);
    font-variation-settings: var(--display-fvs);
    letter-spacing: -0.035em;
  }
  .brand__name i {
    font-style: normal;
    color: var(--c1);
    display: inline-block;
    transition: transform 0.55s var(--ease-spring);
  }
  .brand:hover .brand__name i {
    transform: translateY(-0.22em) scale(1.3);
  }
  .brand__role {
    font-family: var(--font-alt);
    font-size: 0.63rem;
    font-weight: 550;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  @media (max-width: 460px) {
    .brand__role {
      display: none;
    }
  }

  /* ── Enlaces de escritorio, con una píldora que se desliza ──────────── */
  .nav__links {
    position: relative;
    display: none;
    gap: 0.15rem;
    padding: 0.28rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg-2) 55%, transparent);
  }

  .nav__pill {
    position: absolute;
    top: 0.28rem;
    bottom: 0.28rem;
    left: 0;
    width: var(--pw, 0px);
    border-radius: 999px;
    background: var(--ink);
    transform: translate3d(var(--px, 0px), 0, 0);
    opacity: 0;
    transition: transform 0.5s var(--ease-out), width 0.5s var(--ease-out),
      opacity 0.35s var(--ease-out);
    pointer-events: none;
  }
  .nav__links[data-pill] .nav__pill {
    opacity: 1;
  }

  /* Los enlaces y su copia comparten métrica exacta: si no, la capa
     recortada se desalinea y el texto se ve doble. */
  .nav__links a,
  .nav__mask span {
    padding: 0.44em 0.95em;
    border-radius: 999px;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 550;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav__links a {
    position: relative;
    color: var(--ink-2);
    transition: color 0.35s var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--ink);
  }

  .nav__mask {
    position: absolute;
    inset: 0;
    display: flex;
    gap: 0.15rem;
    padding: 0.28rem;
    color: var(--bg);
    pointer-events: none;
    clip-path: inset(0 calc(100% - var(--px, 0px) - var(--pw, 0px)) 0 var(--px, 0px) round 999px);
    transition: clip-path 0.5s var(--ease-out);
  }

  .nav__side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── Hamburguesa ────────────────────────────────────────────────────── */
  .burger {
    position: relative;
    width: 42px;
    height: 34px;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .burger span[aria-hidden] {
    display: block;
    width: 16px;
    height: 1.6px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.45s var(--ease-out), opacity 0.3s var(--ease-out);
  }
  .burger[aria-expanded='true'] span[aria-hidden]:first-of-type {
    transform: translateY(3.8px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span[aria-hidden]:last-of-type {
    transform: translateY(-3.8px) rotate(-45deg);
  }

  /* ── Panel móvil ────────────────────────────────────────────────────── */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    align-content: center;
    padding: 6rem var(--gutter) 3rem;
    background: color-mix(in oklab, var(--bg) 94%, transparent);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    clip-path: circle(0% at calc(100% - 3.4rem) 2.4rem);
    transition: clip-path 0.7s var(--ease-out);
  }
  .sheet[hidden] {
    display: grid;
    pointer-events: none;
    visibility: hidden;
  }
  .sheet[data-open] {
    clip-path: circle(150% at calc(100% - 3.4rem) 2.4rem);
    visibility: visible;
    pointer-events: auto;
  }

  .sheet nav {
    display: grid;
    gap: 0.1rem;
  }
  .sheet nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.34em;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--display-weight);
    line-height: 1.05;
    letter-spacing: -0.04em;
    font-variation-settings: var(--display-fvs);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out),
      color 0.3s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }
  .sheet nav a em {
    font-family: var(--font-alt);
    font-size: 0.7rem;
    font-style: normal;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .sheet nav a:hover {
    color: var(--c1);
  }

  .sheet__foot {
    display: grid;
    justify-items: start;
    gap: 1.3rem;
    margin-top: 2.4rem;
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }
  .sheet__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.6rem;
    font-family: var(--font-alt);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .sheet[data-open] nav a,
  .sheet[data-open] .sheet__foot {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 940px) {
    .nav__links {
      display: flex;
    }
    .burger {
      display: none;
    }
    .sheet {
      display: none !important;
    }
  }
  @media (max-width: 939px) {
    .nav__cta {
      display: none;
    }
  }
  @media (min-width: 940px) {
    .nav__cta {
      display: inline-flex;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const sheet = document.querySelector<HTMLElement>('.sheet');

  // ── Fondo de la barra al bajar ────────────────────────────────────────
  // La barra ya no se esconde: ese salto era lo que se sentía brusco.
  if (nav) {
    let ticking = false;
    const update = () => {
      nav.toggleAttribute('data-stuck', window.scrollY > 16);
      ticking = false;
    };
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // ── Menú móvil ────────────────────────────────────────────────────────
  if (burger && sheet) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        sheet.hidden = false;
        requestAnimationFrame(() => sheet.setAttribute('data-open', ''));
      } else {
        sheet.removeAttribute('data-open');
        setTimeout(() => {
          if (!sheet.hasAttribute('data-open')) sheet.hidden = true;
        }, 700);
      }
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true'),
    );
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.hasAttribute('data-open')) setOpen(false);
    });
  }

  // ── Sección activa: una sola píldora que se desliza ───────────────────
  const list = document.querySelector<HTMLElement>('.nav__links');
  const spies = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));

  if (list && spies.length) {
    let active: HTMLAnchorElement | null = null;

    const moveTo = (el: HTMLAnchorElement | null) => {
      if (!el) {
        list.removeAttribute('data-pill');
        return;
      }
      list.style.setProperty('--px', `${el.offsetLeft}px`);
      list.style.setProperty('--pw', `${el.offsetWidth}px`);
      list.setAttribute('data-pill', '');
    };

    const setActive = (el: HTMLAnchorElement | null) => {
      active = el;
      spies.forEach((a) => a.toggleAttribute('data-active', a === el));
      moveTo(el);
    };

    const targets = spies
      .map((a) => document.getElementById(a.dataset.spy!))
      .filter((el): el is HTMLElement => Boolean(el));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          setActive(spies.find((a) => a.dataset.spy === entry.target.id) ?? null);
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((el) => io.observe(el));

    // La píldora acompaña al puntero y vuelve a la sección activa al salir
    spies.forEach((a) => a.addEventListener('pointerenter', () => moveTo(a)));
    list.addEventListener('pointerleave', () => moveTo(active));
    addEventListener('resize', () => moveTo(active), { passive: true });
  }
</script>
