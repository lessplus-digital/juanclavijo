---
import { profile, sections } from '@/config/site';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const links = sections.filter((s) => s.enabled && s.nav);
---

<header class="nav" data-nav>
  <div class="nav__inner shell">
    <a class="brand" href="/" aria-label="Inicio">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" role="presentation">
          <circle cx="20" cy="20" r="18.5" />
          <path d="M26.5 10.5v13.2c0 3.9-2.6 6.3-6.6 6.3-3.7 0-6.2-2-6.9-5.3" />
        </svg>
      </span>
      <span class="brand__text">
        <b>Juan Clavijo</b>
        <i>{profile.role}</i>
      </span>
    </a>

    {
      !compact && (
        <nav class="nav__links" aria-label="Secciones">
          {links.map((s) => (
            <a href={`/#${s.id}`} data-spy={s.id}>
              <span>{s.nav}</span>
            </a>
          ))}
        </nav>
      )
    }

    <div class="nav__side">
      <ThemeToggle />
      <a class="btn nav__cta" href={`mailto:${profile.email}`}>
        Hablemos
        <svg class="arrow" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
          <path
            d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="menu-movil">
        <span class="sr-only">Abrir menú</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="menu-movil" hidden>
  <div class="sheet__inner">
    <nav aria-label="Secciones">
      {
        links.map((s, i) => (
          <a href={`/#${s.id}`} style={`--i:${i}`}>
            <em class="mono-num">{s.index}</em>
            <span>{s.nav}</span>
          </a>
        ))
      }
    </nav>
    <div class="sheet__foot" style={`--i:${links.length}`}>
      <a class="link-u" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="link-u" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding-block: clamp(0.7rem, 1.4vw, 1.1rem);
    transition: background-color 0.5s var(--ease-out), border-color 0.5s var(--ease-out),
      backdrop-filter 0.5s var(--ease-out), transform 0.55s var(--ease-out);
    border-bottom: 1px solid transparent;
  }

  .nav[data-stuck] {
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border-bottom-color: var(--line);
  }

  .nav[data-hidden] {
    transform: translateY(-104%);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Marca */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .brand__mark svg {
    width: 34px;
    height: 34px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    overflow: visible;
  }
  .brand__mark circle {
    stroke: var(--line-strong);
    transition: stroke 0.5s var(--ease-out), transform 0.9s var(--ease-spring);
    transform-origin: center;
  }
  .brand:hover .brand__mark circle {
    stroke: var(--c1);
    transform: rotate(180deg) scale(1.06);
  }
  .brand__text {
    display: grid;
    line-height: 1.1;
  }
  .brand__text b {
    font-family: var(--font-alt);
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: -0.02em;
  }
  .brand__text i {
    font-style: normal;
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* Enlaces de escritorio */
  .nav__links {
    display: none;
    gap: 0.15rem;
    padding: 0.28rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg-2) 55%, transparent);
  }
  .nav__links a {
    position: relative;
    padding: 0.42em 0.95em;
    border-radius: 999px;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 550;
    letter-spacing: 0.01em;
    color: var(--ink-2);
    transition: color 0.35s var(--ease-out);
  }
  .nav__links a::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--ink);
    transform: scale(0.6);
    opacity: 0;
    transition: transform 0.45s var(--ease-spring), opacity 0.35s var(--ease-out);
  }
  .nav__links a span {
    position: relative;
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__links a[data-active] {
    color: var(--bg);
  }
  .nav__links a[data-active]::before {
    transform: scale(1);
    opacity: 1;
  }

  .nav__side {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav__cta {
    display: none;
    padding: 0.62em 1.15em;
  }

  /* Hamburguesa */
  .burger {
    position: relative;
    width: 42px;
    height: 34px;
    display: grid;
    place-content: center;
    gap: 6px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .burger span[aria-hidden] {
    display: block;
    width: 16px;
    height: 1.6px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.5s var(--ease-spring), opacity 0.3s var(--ease-out);
  }
  .burger[aria-expanded='true'] span[aria-hidden]:first-of-type {
    transform: translateY(3.8px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span[aria-hidden]:last-of-type {
    transform: translateY(-3.8px) rotate(-45deg);
  }

  /* Panel móvil */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 95;
    display: grid;
    align-content: center;
    padding: 6rem var(--gutter) 3rem;
    background: color-mix(in oklab, var(--bg) 94%, transparent);
    backdrop-filter: blur(22px) saturate(1.3);
    -webkit-backdrop-filter: blur(22px) saturate(1.3);
    clip-path: circle(0% at calc(100% - 3.4rem) 2.4rem);
    transition: clip-path 0.75s var(--ease-out);
  }
  .sheet[hidden] {
    display: grid;
  }
  .sheet[hidden] {
    pointer-events: none;
    visibility: hidden;
  }
  .sheet[data-open] {
    clip-path: circle(150% at calc(100% - 3.4rem) 2.4rem);
    visibility: visible;
    pointer-events: auto;
  }

  .sheet nav {
    display: grid;
    gap: 0.1rem;
  }
  .sheet nav a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.32em;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 100, var(--wonk-on);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out),
      color 0.3s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }
  .sheet nav a em {
    font-family: var(--font-alt);
    font-size: 0.7rem;
    font-style: normal;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .sheet nav a:hover {
    color: var(--c1);
  }
  .sheet__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2.4rem;
    font-family: var(--font-alt);
    font-size: var(--step--1);
    color: var(--ink-2);
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out);
    transition-delay: calc(var(--i) * 55ms + 120ms);
  }
  .sheet[data-open] nav a,
  .sheet[data-open] .sheet__foot {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 900px) {
    .nav__links {
      display: flex;
    }
    .nav__cta {
      display: inline-flex;
    }
    .burger {
      display: none;
    }
    .sheet {
      display: none !important;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const sheet = document.querySelector<HTMLElement>('.sheet');

  // ── Barra: fondo al bajar, se esconde al hacer scroll hacia abajo ─────────
  if (nav) {
    let last = window.scrollY;
    let ticking = false;

    const update = () => {
      const y = window.scrollY;
      nav.toggleAttribute('data-stuck', y > 16);
      const menuOpen = sheet?.hasAttribute('data-open');
      nav.toggleAttribute('data-hidden', !menuOpen && y > 420 && y > last + 4);
      last = y;
      ticking = false;
    };

    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // ── Menú móvil ────────────────────────────────────────────────────────────
  if (burger && sheet) {
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.querySelector('.sr-only')!.textContent = open ? 'Cerrar menú' : 'Abrir menú';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) {
        sheet.hidden = false;
        requestAnimationFrame(() => sheet.setAttribute('data-open', ''));
      } else {
        sheet.removeAttribute('data-open');
        setTimeout(() => {
          if (!sheet.hasAttribute('data-open')) sheet.hidden = true;
        }, 700);
      }
    };

    burger.addEventListener('click', () =>
      setOpen(burger.getAttribute('aria-expanded') !== 'true'),
    );
    sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sheet.hasAttribute('data-open')) setOpen(false);
    });
  }

  // ── Sección activa en el menú ─────────────────────────────────────────────
  const spies = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  if (spies.length) {
    const targets = spies
      .map((a) => document.getElementById(a.dataset.spy!))
      .filter((el): el is HTMLElement => Boolean(el));

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          spies.forEach((a) => a.toggleAttribute('data-active', a.dataset.spy === entry.target.id));
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
