---
import type { SectionDef } from '@/config/site';
import { profile, about, education } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;

// El tramo entre asteriscos va en cursiva y color de acento.
const statementParts = about.statement.split('*');
const [firstParagraph, ...restParagraphs] = profile.bio;
---

<section class="section about" id={section.id}>
  <div class="shell">
    {/*
      Título y frase de apertura comparten fila: apilados uno tras otro
      competían entre sí y dejaban toda la mitad derecha vacía.
    */}
    <div class="about__head">
      <SectionHead
        index={section.index}
        eyebrow={section.eyebrow}
        title={section.title}
        flush
      />

      <p class="stmt" data-reveal="mask">
        <span>
          {
            statementParts.map((part, i) =>
              i % 2 === 1 ? <em>{part}</em> : <Fragment>{part}</Fragment>,
            )
          }
        </span>
      </p>
    </div>

    <div class="cols">
      <p class="cols__lead" data-reveal>{firstParagraph}</p>
      <div class="cols__rest">
        {
          restParagraphs.map((paragraph, i) => (
            <p data-reveal style={`--d:${(i + 1) * 90}ms`}>
              {paragraph}
            </p>
          ))
        }
      </div>
    </div>

    <div class="places" data-reveal>
      <span class="places__label">{about.countriesLabel}</span>
      <ul>
        {about.countries.map((country) => <li class="chip">{country}</li>)}
      </ul>
    </div>

    <div class="edu" data-reveal>
      <h3 class="edu__title">Formación</h3>
      <ul class="edu__grid">
        {
          education.map((e) => (
            <li>
              <span class="edu__year mono-num">{e.period}</span>
              <span class="edu__name">{e.title}</span>
              <span class="edu__place">{e.place}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* ── Encabezado en dos columnas ─────────────────────────────────────── */
  .about__head {
    display: grid;
    gap: clamp(1.6rem, 3.5vw, 3rem);
    margin-bottom: clamp(2.4rem, 5vw, 3.8rem);
  }

  .stmt {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: var(--display-weight);
    font-variation-settings: var(--display-fvs);
    line-height: 1.16;
    letter-spacing: -0.032em;
    max-width: 26ch;
    text-wrap: balance;
    padding-left: clamp(0.9rem, 1.5vw, 1.2rem);
    border-left: 2px solid var(--c1);
  }
  .stmt em {
    font-style: italic;
    color: var(--c1);
  }

  /* ── Texto ──────────────────────────────────────────────────────────── */
  .cols {
    display: grid;
    gap: clamp(1.4rem, 3vw, 3rem);
    padding-top: clamp(1.6rem, 3vw, 2.4rem);
    border-top: 1px solid var(--line);
  }
  .cols__lead {
    font-size: var(--step-1);
    line-height: 1.45;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 40ch;
  }
  .cols__rest {
    display: grid;
    gap: 1.1em;
    max-width: 48ch;
  }
  .cols__rest p {
    color: var(--ink-2);
  }
  .cols__rest p:last-child {
    color: var(--ink);
  }

  /* ── Países ─────────────────────────────────────────────────────────── */
  .places {
    display: grid;
    gap: 0.9rem;
    margin-top: clamp(2.2rem, 4.5vw, 3.4rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .places__label,
  .edu__title {
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .places ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* ── Formación: las tres columnas comparten forma ───────────────────── */
  .edu {
    margin-top: clamp(2.2rem, 4.5vw, 3.4rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .edu__title {
    display: block;
    margin-bottom: 1.3rem;
  }
  .edu__grid {
    display: grid;
    gap: 1.4rem;
  }
  .edu__grid li {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding-left: 1.1rem;
    border-left: 2px solid var(--line);
    transition: border-color 0.45s var(--ease-out), padding-left 0.45s var(--ease-out);
  }
  .edu__grid li:hover {
    border-left-color: var(--c1);
    padding-left: 1.4rem;
  }
  .edu__year {
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .edu__name {
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.25;
    text-wrap: balance;
  }
  .edu__place {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 900px) {
    .about__head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: end;
      gap: clamp(2rem, 5vw, 5rem);
    }
    .stmt {
      /* Asienta la frase sobre la línea base del titular */
      margin-bottom: 0.35rem;
    }
  }

  @media (min-width: 820px) {
    .cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 4rem);
    }
    .edu__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(1.4rem, 3vw, 2.4rem);
    }
  }
</style>
