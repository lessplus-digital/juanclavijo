---
import { getCollection } from 'astro:content';
import type { SectionDef } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import ProjectShot from '@/components/ProjectShot.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Dos grupos, no un carrusel: un carrusel escondería casi todo el portafolio.
 *
 * Los productos con maqueta animada ocupan una fila entera cada uno, alternando
 * el lado. Los sitios terminados van de dos en dos con su captura: no hay nada
 * que animar en ellos y darles el mismo tamaño restaba fuerza a los que sí
 * tienen algo que enseñar. La numeración es continua entre los dos grupos, así
 * que se siguen leyendo como una sola lista.
 *
 * HOY LOS TRES PROYECTOS SON ESCENAS y el segundo grupo sale vacío: el bloque
 * de capturas y su línea de separación no se pintan. El camino de `layout:
 * shot` sigue vivo para el siguiente proyecto que no tenga nada que animar.
 *
 * El índice se calcula sobre `projects` entero para que no se repita entre
 * grupos. Añadir un proyecto es añadir un .md: cae en su grupo según `layout`.
 *
 * Cuando queda UNA sola captura, la retícula de dos columnas la dejaría en la
 * mitad izquierda con un hueco al lado. En ese caso la tarjeta pasa a fila
 * (`solo`): la captura a un lado y el texto al otro, ocupando el ancho entero.
 */
const indexed = projects.map((project, i) => ({ project, i }));
const rows = indexed.filter(({ project }) => project.data.layout === 'scene');
const shots = indexed.filter(({ project }) => project.data.layout === 'shot');
---

<section class="section projects" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="projects__rows">
      {rows.map(({ project, i }) => <ProjectRow project={project} index={i} />)}
    </div>

    {
      shots.length > 0 && (
        <div class:list={['projects__shots', shots.length === 1 && 'projects__shots--solo']}>
          {shots.map(({ project, i }) => (
            <ProjectShot project={project} index={i} solo={shots.length === 1} />
          ))}
        </div>
      )
    }

    {
      projects.length === 0 && (
        <p class="projects__empty">
          Copia <code>src/content/projects/_plantilla.md</code> para publicar tu primer caso.
        </p>
      )
    }
  </div>
</section>

<style>
  .projects__rows {
    display: grid;
    gap: clamp(4rem, 9vw, 8.5rem);
  }

  .projects__shots {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(4rem, 9vw, 8.5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    /* Una línea separa los dos grupos sin necesidad de otro encabezado. */
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .projects__shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .projects__shots--solo {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .projects__empty {
    padding: 3rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--ink-3);
  }
  .projects__empty code {
    font-family: var(--font-alt);
    font-size: 0.9em;
    color: var(--c1);
  }
</style>
