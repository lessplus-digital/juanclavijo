---
import { getCollection } from 'astro:content';
import type { SectionDef } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import ProjectShot from '@/components/ProjectShot.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/**
 * Dos grupos, no un carrusel: con cuatro proyectos un carrusel escondería tres.
 *
 * Los productos con maqueta animada ocupan una fila entera cada uno, alternando
 * el lado. Los sitios terminados van de dos en dos con su captura: no hay nada
 * que animar en ellos y darles el mismo tamaño restaba fuerza a los dos
 * primeros. La numeración (01…04) es continua, así que se siguen leyendo como
 * una sola lista.
 *
 * El índice se calcula sobre `projects` entero para que no se repita entre
 * grupos. Añadir un proyecto es añadir un .md: cae en su grupo según `layout`.
 */
const indexed = projects.map((project, i) => ({ project, i }));
const rows = indexed.filter(({ project }) => project.data.layout === 'scene');
const shots = indexed.filter(({ project }) => project.data.layout === 'shot');
---

<section class="section projects" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="projects__rows">
      {rows.map(({ project, i }) => <ProjectRow project={project} index={i} />)}
    </div>

    {
      shots.length > 0 && (
        <div class="projects__shots">
          {shots.map(({ project, i }) => (
            <ProjectShot project={project} index={i} />
          ))}
        </div>
      )
    }

    {
      projects.length === 0 && (
        <p class="projects__empty">
          Copia <code>src/content/projects/_plantilla.md</code> para publicar tu primer caso.
        </p>
      )
    }
  </div>
</section>

<style>
  .projects__rows {
    display: grid;
    gap: clamp(4rem, 9vw, 8.5rem);
  }

  .projects__shots {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(4rem, 9vw, 8.5rem);
    padding-top: clamp(3rem, 6vw, 5rem);
    /* Una línea separa los dos grupos sin necesidad de otro encabezado. */
    border-top: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .projects__shots {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .projects__empty {
    padding: 3rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    text-align: center;
    color: var(--ink-3);
  }
  .projects__empty code {
    font-family: var(--font-alt);
    font-size: 0.9em;
    color: var(--c1);
  }
</style>
