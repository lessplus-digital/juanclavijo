---
import type { SectionDef } from '@/config/site';
import { experience, profile } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
---

<section class="section exp" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ol class="exp__list">
      {
        experience.map((job, i) => (
          <li class="exp__item" data-reveal style={`--d:${i * 90}ms`}>
            <div class="exp__when">
              <span class="exp__dot" data-current={job.current || undefined} aria-hidden="true" />
              <span class="exp__period mono-num">{job.period}</span>
              <span class="exp__place">{job.place}</span>
            </div>

            <div class="exp__what">
              <h3 class="exp__company">
                <span class="exp__companyName">{job.company}</span>
                <span class="exp__role">{job.role}</span>
              </h3>
              <ul class="exp__bullets">
                {job.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="exp__cv" data-reveal>
      El detalle completo está en el CV.
      <a class="link-u" href={profile.cv} target="_blank" rel="noreferrer">Descargar PDF ↓</a>
    </p>
  </div>
</section>

<style>
  .exp__list {
    border-top: 1px solid var(--line);
  }

  .exp__item {
    display: grid;
    gap: 0.9rem 2rem;
    padding-block: clamp(1.8rem, 3.6vw, 2.8rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.5s var(--ease-out);
  }

  .exp__when {
    position: relative;
    display: grid;
    gap: 0.2rem;
    align-content: start;
    padding-left: 1.5rem;
  }

  .exp__dot {
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
  }
  .exp__dot[data-current] {
    background: var(--c2);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 60%, transparent);
    animation: exp-pulse 2.8s var(--ease-out) infinite;
  }
  @keyframes exp-pulse {
    60% {
      box-shadow: 0 0 0 10px color-mix(in oklab, var(--c2) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 0%, transparent);
    }
  }

  .exp__period {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .exp__place {
    font-size: var(--step--2);
    color: var(--ink-3);
  }

  .exp__company {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
  }
  .exp__companyName {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
  }
  .exp__role {
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--c1);
  }

  .exp__bullets {
    display: grid;
    gap: 0.6rem;
    margin-top: 1rem;
    max-width: 66ch;
  }
  .exp__bullets li {
    position: relative;
    padding-left: 1.35rem;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .exp__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 1.5px;
    background: var(--line-strong);
    transition: width 0.4s var(--ease-out), background-color 0.4s var(--ease-out);
  }
  .exp__bullets li:hover::before {
    width: 14px;
    background: var(--c1);
  }

  .exp__cv {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
    font-size: var(--step--1);
    color: var(--ink-3);
  }

  @media (min-width: 900px) {
    .exp__item {
      grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    }
  }
</style>
