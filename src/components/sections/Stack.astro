---
import type { SectionDef } from '@/config/site';
import { stack } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
const accents = ['c1', 'c3', 'c2', 'c4'];
---

<section class="section stack" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <div class="stack__grid">
      {
        stack.map((group, gi) => (
          <div
            class="stack__group card"
            style={`--accent: var(--${accents[gi % accents.length]}); --d:${gi * 80}ms`}
            data-reveal
          >
            <h3 class="stack__name">
              <span class="stack__bullet" aria-hidden="true" />
              {group.group}
            </h3>
            <ul class="stack__items">
              {group.items.map((item, i) => (
                <li style={`--i:${i}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack__grid {
    display: grid;
    align-items: start;
    gap: clamp(0.9rem, 2vw, 1.4rem);
  }

  .stack__group {
    padding: clamp(1.3rem, 2.8vw, 1.9rem);
  }
  .stack__group:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--line));
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .stack__name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 1.1rem;
  }

  .stack__bullet {
    width: 9px;
    height: 9px;
    border-radius: 3px;
    background: var(--accent);
    transition: transform 0.6s var(--ease-spring), border-radius 0.6s var(--ease-out);
  }
  .stack__group:hover .stack__bullet {
    transform: rotate(45deg) scale(1.2);
    border-radius: 50%;
  }

  .stack__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.42rem;
  }
  .stack__items li {
    padding: 0.36em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 50%, transparent);
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 500;
    color: var(--ink-2);
    transition: transform 0.4s var(--ease-spring), color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out), background-color 0.3s var(--ease-out);
  }
  .stack__items li:hover {
    transform: translateY(-3px) rotate(-1.5deg);
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }

  @media (min-width: 720px) {
    .stack__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
