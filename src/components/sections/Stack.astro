---
/**
 * Herramientas: un campo de logotipos sueltos flotando en 3D.
 *
 * CÓMO SE ENTIENDE QUÉ ES FRONT Y QUÉ ES BACK
 * No hay tarjetas ni filas. Lo que agrupa es el color —cada capa tiene su
 * acento y la leyenda de arriba lo declara— y sobre todo la PROFUNDIDAD: cada
 * capa vive en su franja de Z, así que el frontend flota cerca del visitante y
 * la infraestructura queda al fondo, más pequeña y más apagada. Las posiciones
 * en X e Y sí son libres y desordenadas.
 *
 * LAS POSICIONES SE CALCULAN AL COMPILAR, CON SEMILLA FIJA
 * Una retícula invisible (8×4 en escritorio, 4×8 en móvil) con un empujón
 * aleatorio dentro de cada celda: parece regado, pero nada se solapa. Al ir con
 * semilla, el reparto es idéntico en cada build; si cambias SEED cambia el
 * cuadro entero.
 *
 * CADA LOGO SE MUEVE POR SU CUENTA
 * Un único @keyframes (`drift`) al que cada logo le pasa su amplitud
 * (--dx/--dy/--dz), su duración y su retardo. Con eso no hay dos que vayan
 * sincronizados y no hace falta escribir treinta y dos animaciones.
 *
 * EL REPARTO DE PROPIEDADES NO ES ARBITRARIO
 *  · `translate` → sitio en Z y deriva (la animación).
 *  · `transform` → el salto al pasar el ratón.
 * Son propiedades distintas y se componen sin pisarse.
 */
import type { SectionDef } from '@/config/site';
import { stack } from '@/config/site';
import { getBrand } from '@/config/brands';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;

const accents = ['c1', 'c3', 'c2', 'c4'];

/** Franja de profundidad de cada capa, en px. Frontend delante, infra al fondo. */
const bands = [
  [110, 190],
  [10, 85],
  [-80, -10],
  [-180, -95],
];

const SEED = 20260902;

/** PRNG con semilla (mulberry32): el mismo cuadro en cada compilación. */
function makeRng(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = makeRng(SEED);

/** Celda con empujón: reparte sin apelmazar y sin solapar. */
function scatter(index: number, cols: number, rows: number, jitter: number) {
  const col = index % cols;
  const row = Math.floor(index / cols) % rows;
  const cw = 100 / cols;
  const ch = 100 / rows;
  const x = cw * (col + 0.5) + (rand() - 0.5) * cw * jitter;
  const y = ch * (row + 0.5) + (rand() - 0.5) * ch * jitter;
  // Margen para que ningún logo se salga al derivar ni al acercarse.
  return { x: Math.min(93, Math.max(7, x)), y: Math.min(92, Math.max(8, y)) };
}

const flat = stack.flatMap((group, gi) =>
  group.items.map((item) => ({
    name: item.name,
    mark: 'mark' in item ? item.mark : undefined,
    brand: getBrand('icon' in item ? item.icon : undefined),
    gi,
  })),
);

/**
 * Barajado con la misma semilla: las capas quedan entremezcladas por la
 * pantalla en vez de en cuatro bandas horizontales. La profundidad sigue
 * contando de qué capa es cada logo.
 */
const order = flat.map((_, i) => i);
for (let i = order.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [order[i], order[j]] = [order[j], order[i]];
}

const nodes = order.map((srcIndex, i) => {
  const it = flat[srcIndex];
  const [z0, z1] = bands[it.gi];
  return {
    ...it,
    accent: accents[it.gi % accents.length],
    pos: scatter(i, 8, 4, 0.62),
    posMobile: scatter(i, 4, 8, 0.3),
    z: Math.round(z0 + rand() * (z1 - z0)),
    // Deriva propia: amplitud, duración y arranque distintos en cada logo.
    dx: (rand() * 2 - 1) * 22,
    dy: (rand() * 2 - 1) * 20,
    dz: Math.round(rand() * 34 + 10),
    dur: (rand() * 9 + 11).toFixed(1),
    delay: (-rand() * 20).toFixed(1),
  };
});

const legend = stack.map((group, gi) => ({
  name: group.group,
  note: group.note,
  accent: accents[gi % accents.length],
  count: group.items.length,
}));
---

<section class="section stack" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="key" data-reveal>
      {
        legend.map((l) => (
          <li class="key__item" style={`--accent: var(--${l.accent})`}>
            <span class="key__dot" />
            <span class="key__txt">
              <b>{l.name}</b>
              <em>{l.note}</em>
            </span>
            <span class="key__n mono-num">{l.count}</span>
          </li>
        ))
      }
    </ul>

    <div class="field" data-reveal data-field>
      <div class="field__rig" data-rig>
        {
          nodes.map((n) => (
            <div
              class="node"
              style={`--accent: var(--${n.accent}); --x:${n.pos.x.toFixed(2)}%; --y:${n.pos.y.toFixed(2)}%; --mx:${n.posMobile.x.toFixed(2)}%; --my:${n.posMobile.y.toFixed(2)}%; --z:${n.z}px; --dx:${n.dx.toFixed(1)}px; --dy:${n.dy.toFixed(1)}px; --dz:${n.dz}px; --dur:${n.dur}s; --delay:${n.delay}s${n.brand?.hex ? `; --brand:${n.brand.hex}` : ''}`}
            >
              <span class="node__tile">
                {n.brand ? (
                  <svg class="node__ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={n.brand.path} fill="currentColor" />
                  </svg>
                ) : (
                  <span class="node__ico node__ico--txt" aria-hidden="true">
                    {n.mark ?? n.name.slice(0, 2).toUpperCase()}
                  </span>
                )}
              </span>
              {/* Solo para lectores de pantalla: lo que se ve es la etiqueta plana. */}
              <span class="node__name sr-only">{n.name}</span>
            </div>
          ))
        }
      </div>

      <span class="tip" data-tip aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /* ── Leyenda ────────────────────────────────────────────────────────── */
  .key {
    display: grid;
    gap: 0.75rem 1.6rem;
    margin: clamp(1.6rem, 3vw, 2.6rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .key__item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .key__dot {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0.28rem color-mix(in oklab, var(--accent) 20%, transparent);
  }
  .key__txt {
    display: grid;
    line-height: 1.25;
  }
  .key__txt b {
    font-family: var(--font-alt);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--ink);
  }
  .key__txt em {
    font-size: var(--step--2);
    font-style: normal;
    color: var(--ink-3);
  }
  .key__n {
    margin-left: auto;
    font-size: var(--step--2);
    color: color-mix(in oklab, var(--accent) 70%, var(--ink-3));
  }

  @media (min-width: 620px) {
    .key {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1040px) {
    .key {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .key__n {
      margin-left: 0.3rem;
    }
  }

  /* ── El campo ───────────────────────────────────────────────────────── */
  .field {
    position: relative;
    margin-top: clamp(1.6rem, 3vw, 2.6rem);
    aspect-ratio: 5 / 8;
    perspective: 2200px;
    perspective-origin: 50% 45%;
  }

  .field__rig {
    position: absolute;
    inset: 8% 5%;
    pointer-events: none;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }

  .node {
    --size: clamp(38px, 11vw, 52px);
    position: absolute;
    left: var(--mx);
    top: var(--my);
    /* El ancla es el centro de la ficha, no su esquina. */
    margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2);
    display: grid;
    justify-items: center;
    pointer-events: auto;
    --amp: 0.5;
    translate: 0 0 var(--z);
    animation: drift var(--dur) var(--ease-io) var(--delay) infinite;
    /* Los del fondo se apagan un poco: es la otra mitad de la profundidad,
       junto al tamaño que ya les da la perspectiva. */
    opacity: clamp(0.6, calc(0.86 + var(--z) / 620), 1);
    transition: opacity 0.4s var(--ease-out);
  }

  .node__tile {
    display: grid;
    place-items: center;
    width: var(--size);
    height: var(--size);
    border: 1px solid var(--line);
    border-radius: 30%;
    background: color-mix(in oklab, var(--bg-2) 78%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    box-shadow: var(--shadow-soft);
    /* En reposo, teñido del acento de su capa. El color de marca aparece al
       pasar el ratón: treinta y dos logos a todo color se comen la paleta. */
    color: color-mix(in oklab, var(--accent) 78%, var(--ink-3));
    transition: transform 0.5s var(--ease-spring), border-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }

  .node__ico {
    display: grid;
    place-items: center;
    width: 52%;
    height: 52%;
  }
  .node__ico--txt {
    width: auto;
    height: auto;
    font-family: var(--font-alt);
    font-size: calc(var(--size) * 0.3);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }


  .node:hover {
    opacity: 1;
  }
  .node:hover .node__tile {
    transform: scale(1.1);
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    box-shadow: var(--shadow-lift);
    /* Sin `--brand` (logos negros o blancos puros, que se perderían en uno de
       los dos temas) se recurre a la tinta. Lo decide brands.ts. */
    color: var(--brand, var(--ink));
  }

  /* Etiqueta única, hermana del rig y FUERA del contexto 3D: por eso se pinta
     siempre encima y se lee del mismo tamaño esté el logo cerca o lejos. La
     coloca el script sobre el logo que tenga el puntero. */
  .tip {
    position: absolute;
    left: 0;
    top: 0;
    translate: calc(var(--tx, 0px) - 50%) var(--ty, 0px);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--font-alt);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s var(--ease-out);
    pointer-events: none;
  }
  .tip[data-on] {
    opacity: 1;
  }

  /* Una sola animación para los treinta y dos: la amplitud, la duración y el
     arranque los pone cada logo en sus propias variables. */
  @keyframes drift {
    0%,
    100% {
      translate: 0 0 var(--z);
    }
    33% {
      translate: calc(var(--dx) * var(--amp)) calc(var(--dy) * var(--amp))
        calc(var(--z) + var(--dz) * var(--amp));
    }
    66% {
      translate: calc(var(--dx) * var(--amp) * -0.7) calc(var(--dy) * var(--amp) * -0.85)
        calc(var(--z) - var(--dz) * var(--amp));
    }
  }

  @media (min-width: 760px) {
    .field {
      aspect-ratio: 2 / 1;
      perspective: 1250px;
    }
    .node {
      --size: clamp(46px, 4.4vw, 60px);
      --amp: 1;
      left: var(--x);
      top: var(--y);
    }
  }

  /* Fuera de pantalla no deriva nada: treinta y dos animaciones a la vez fuera
     de la vista no valen la batería. */
  .field:not([data-live]) .node {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Se apaga la deriva y toda transición. El aumento de la ficha se queda,
       pero instantáneo: no es movimiento, es un cambio de estado. */
    .node,
    .node__tile,
    .tip {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  // ── Paralaje del puntero ──────────────────────────────────────────────
  // Mismo patrón que el campo de blobs del hero: un bucle de rAF que interpola
  // hacia el objetivo y se apaga solo al llegar, en vez de escribir estilos en
  // cada `pointermove`. La profundidad de cada logo hace el resto: los de
  // delante se desplazan más que los del fondo sin una línea extra.
  const field = document.querySelector<HTMLElement>('[data-field]');
  const rig = field?.querySelector<HTMLElement>('[data-rig]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(pointer: fine)').matches;

  if (field) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.target.toggleAttribute('data-live', e.isIntersecting);
      },
      { rootMargin: '150px 0px' },
    );
    io.observe(field);
  }

  // ── Etiqueta del logo bajo el puntero ─────────────────────────────────
  // Se coloca en cada fotograma mientras haya un logo activo: los logos van
  // a la deriva, así que una posición fija se quedaría atrás enseguida. El
  // bucle se apaga solo en cuanto el puntero sale.
  const tip = field?.querySelector<HTMLElement>('[data-tip]');
  if (field && tip) {
    let hot: HTMLElement | null = null;
    let tipRaf = 0;

    const place = () => {
      if (!hot) {
        tipRaf = 0;
        return;
      }
      const f = field.getBoundingClientRect();
      const r = hot.getBoundingClientRect();
      tip.style.setProperty('--tx', `${r.left + r.width / 2 - f.left}px`);
      tip.style.setProperty('--ty', `${r.bottom - f.top + 8}px`);
      tipRaf = requestAnimationFrame(place);
    };

    field.addEventListener('pointerover', (e) => {
      const t = e.target as Element | null;
      const node = t?.closest?.('.node') as HTMLElement | null;
      if (!node || node === hot) return;
      hot = node;
      tip.textContent = node.querySelector('.node__name')?.textContent ?? '';
      tip.setAttribute('data-on', '');
      if (!tipRaf) tipRaf = requestAnimationFrame(place);
    });

    const drop = (e: PointerEvent) => {
      // Al saltar de un logo a otro, pointerover ya se encarga de actualizar.
      const to = e.relatedTarget instanceof Element ? e.relatedTarget.closest('.node') : null;
      if (to) return;
      hot = null;
      tip.removeAttribute('data-on');
    };
    field.addEventListener('pointerout', drop);
    field.addEventListener('pointerleave', () => {
      hot = null;
      tip.removeAttribute('data-on');
    });
  }

  if (field && rig && !reduce && fine) {
    const MAX = 7;
    let tx = 0;
    let ty = 0;
    let cx = 0;
    let cy = 0;
    let raf = 0;

    const tick = () => {
      cx += (tx - cx) * 0.08;
      cy += (ty - cy) * 0.08;
      rig.style.setProperty('--rx', `${cx.toFixed(2)}deg`);
      rig.style.setProperty('--ry', `${cy.toFixed(2)}deg`);
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.02 ? requestAnimationFrame(tick) : 0;
    };
    const start = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    field.addEventListener('pointermove', (e) => {
      const r = field.getBoundingClientRect();
      tx = -((e.clientY - r.top) / r.height - 0.5) * MAX;
      ty = ((e.clientX - r.left) / r.width - 0.5) * MAX * 1.4;
      start();
    });

    field.addEventListener('pointerleave', () => {
      tx = 0;
      ty = 0;
      start();
    });
  }
</script>
