---
import type { SectionDef } from '@/config/site';
import { services } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
const accents = ['c1', 'c3', 'c2', 'c4'];
---

<section class="section services" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="svc">
      {
        services.map((s, i) => (
          <li
            class="svc__cell"
            style={`--accent: var(--${accents[i % accents.length]}); --d: ${i * 70}ms`}
            data-reveal
            data-cursor="hot"
          >
            <span class="svc__wash" aria-hidden="true" />
            <div class="svc__head">
              <span class="svc__n mono-num">{s.n}</span>
              <h3 class="svc__title">{s.title}</h3>
            </div>
            <p class="svc__text">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Retícula de servicios: cuatro celdas separadas por filetes, sin cajas.
     Las etiquetas de tecnología se quitaron a propósito — el stack se cuenta
     entero en su propia sección y aquí solo dejaban un vacío a la derecha. */
  .svc {
    display: grid;
    border-block: 1px solid var(--line);
  }

  .svc__cell {
    position: relative;
    padding: clamp(1.35rem, 3vw, 2rem) clamp(0.6rem, 1.6vw, 1.4rem);
    isolation: isolate;
    transition: padding-inline 0.55s var(--ease-out);
  }

  /* Filete entre celdas: en una columna basta el hermano anterior. */
  .svc__cell + .svc__cell {
    border-top: 1px solid var(--line);
  }

  .svc__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      140deg,
      color-mix(in oklab, var(--accent) 14%, transparent),
      transparent 62%
    );
    transform: scale(0.96);
    transform-origin: left top;
    opacity: 0;
    transition: transform 0.7s var(--ease-out), opacity 0.5s var(--ease-out);
  }
  .svc__cell:hover .svc__wash {
    transform: none;
    opacity: 1;
  }
  .svc__cell:hover {
    padding-inline: clamp(1rem, 2.2vw, 1.9rem) clamp(0.6rem, 1.6vw, 1.4rem);
  }

  /* Número y titular en la misma línea: es lo que recorta la altura. */
  .svc__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .svc__n {
    flex: none;
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .svc__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    text-wrap: balance;
    transition: color 0.45s var(--ease-out);
  }
  .svc__cell:hover .svc__title {
    color: var(--accent);
  }

  .svc__text {
    margin-top: 0.5rem;
    /* Sangrado hasta el titular: el número queda como manecilla del margen. */
    margin-left: calc(2ch + 0.75rem);
    max-width: 44ch;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 760px) {
    .svc {
      grid-template-columns: 1fr 1fr;
    }
    /* Con dos columnas el filete horizontal lo llevan las celdas de la
       segunda fila en adelante, y el vertical las de la derecha. */
    .svc__cell + .svc__cell {
      border-top: 0;
    }
    .svc__cell:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .svc__cell:nth-child(2n) {
      border-left: 1px solid var(--line);
      padding-inline-start: clamp(1.1rem, 2.4vw, 2rem);
    }
    .svc__cell:nth-child(2n):hover {
      padding-inline-start: clamp(1.5rem, 3vw, 2.5rem);
    }
  }
</style>
