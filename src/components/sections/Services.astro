---
import type { SectionDef } from '@/config/site';
import { services } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
const accents = ['c1', 'c3', 'c2', 'c4'];
---

<section class="section services" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
    />

    <ul class="svc">
      {
        services.map((s, i) => (
          <li
            class="svc__card"
            style={`--accent: var(--${accents[i % accents.length]}); --d: ${i * 80}ms`}
            data-reveal
            data-cursor="hot"
          >
            <span class="svc__wash" aria-hidden="true" />
            <p class="svc__kicker">
              <span class="svc__n mono-num">{s.n}</span>
              <span class="svc__rule" aria-hidden="true" />
            </p>
            <h3 class="svc__title">{s.title}</h3>
            <p class="svc__text">{s.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Cuatro fichas en 2×2. Antes eran cuatro filas a lo ancho con las
     etiquetas de tecnología alineadas a la derecha: el doble de alto y media
     retícula vacía. Las tecnologías se cuentan en «Con qué lo construyo». */
  .svc {
    --pad: clamp(1.3rem, 2.4vw, 1.9rem);
    display: grid;
    gap: clamp(0.8rem, 1.6vw, 1.25rem);
  }

  .svc__card {
    position: relative;
    display: grid;
    align-content: start;
    padding: var(--pad);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    isolation: isolate;
    overflow: hidden;
    transition: border-color 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .svc__card:hover {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--line));
    transform: translateY(-4px);
  }

  /* Sin sombra ni panel de vidrio: el relleno de acento es lo único que
     enciende la ficha, igual que en las filas anteriores. */
  .svc__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      160deg,
      color-mix(in oklab, var(--accent) 12%, transparent),
      transparent 65%
    );
    opacity: 0;
    transition: opacity 0.55s var(--ease-out);
  }
  .svc__card:hover .svc__wash {
    opacity: 1;
  }

  /* Número + filete que sangra hasta el borde derecho de la ficha: el mismo
     motivo «cifra — línea» del encabezado de sección y de los proyectos. */
  .svc__kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }

  .svc__n {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .svc__rule {
    flex: 1;
    height: 1px;
    margin-right: calc(var(--pad) * -1);
    background: var(--line-strong);
    transition: background-color 0.5s var(--ease-out);
  }
  .svc__card:hover .svc__rule {
    background: var(--accent);
  }

  .svc__title {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1.08;
    text-wrap: balance;
    transition: color 0.45s var(--ease-out);
  }
  .svc__card:hover .svc__title {
    color: var(--accent);
  }

  .svc__text {
    margin-top: 0.6rem;
    max-width: 42ch;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 760px) {
    .svc {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
