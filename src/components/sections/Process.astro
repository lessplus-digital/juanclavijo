---
import type { SectionDef } from '@/config/site';
import { process } from '@/config/site';
import SectionHead from '@/components/SectionHead.astro';

interface Props {
  section: SectionDef;
}
const { section } = Astro.props;
---

<section class="section proc" id={section.id}>
  <div class="shell">
    <SectionHead
      index={section.index}
      eyebrow={section.eyebrow}
      title={section.title}
      intro={section.intro}
      align="end"
    />

    <ol class="proc__track" data-reveal>
      <span class="proc__rail" aria-hidden="true"><i></i></span>
      {
        process.map((p, i) => (
          <li class="proc__step" style={`--i:${i}`}>
            <span class="proc__dot" aria-hidden="true">
              <b class="mono-num">{i + 1}</b>
            </span>
            <h3 class="proc__name">{p.step}</h3>
            <p class="proc__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc__track {
    position: relative;
    display: grid;
    gap: clamp(1.8rem, 4vw, 2.6rem);
    padding-top: 1.6rem;
  }

  /* Riel que se dibuja al entrar en pantalla */
  .proc__rail {
    position: absolute;
    left: 15px;
    top: 1.6rem;
    bottom: 1.5rem;
    width: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .proc__rail i {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(var(--c1), var(--c4), var(--c3), var(--c2));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.6s var(--ease-out) 0.2s;
  }
  .proc__track.is-in .proc__rail i {
    transform: scaleY(1);
  }

  .proc__step {
    position: relative;
    padding-left: 3.2rem;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: calc(var(--i) * 130ms + 250ms);
  }
  .proc__track.is-in .proc__step {
    opacity: 1;
    transform: none;
  }

  .proc__dot {
    position: absolute;
    left: 0;
    top: -2px;
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    transition: border-color 0.5s var(--ease-out), background-color 0.5s var(--ease-out),
      transform 0.6s var(--ease-spring);
  }
  .proc__dot b {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--ink-2);
    transition: color 0.4s var(--ease-out);
  }
  .proc__step:hover .proc__dot {
    border-color: var(--c1);
    background: var(--c1);
    transform: scale(1.12);
  }
  .proc__step:hover .proc__dot b {
    color: var(--on-accent);
  }

  .proc__name {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }
  .proc__text {
    margin-top: 0.4rem;
    max-width: 40ch;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (min-width: 940px) {
    .proc__track {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1.4rem, 2.6vw, 2.4rem);
      padding-top: 3rem;
    }
    .proc__rail {
      left: 15px;
      right: 15px;
      top: 3rem;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .proc__rail i {
      background: linear-gradient(90deg, var(--c1), var(--c4), var(--c3), var(--c2));
      transform: scaleX(0);
      transform-origin: left;
    }
    .proc__track.is-in .proc__rail i {
      transform: scaleX(1);
    }
    .proc__step {
      padding-left: 0;
      padding-top: 3.6rem;
    }
    .proc__dot {
      top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proc__rail i {
      transform: none !important;
    }
    .proc__step {
      opacity: 1;
      transform: none;
    }
  }
</style>
