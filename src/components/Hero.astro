---
import { profile, metrics } from '@/config/site';
import Orb from '@/components/Orb.astro';
import Btn from '@/components/Btn.astro';

const lines = profile.headline.split(' / ');
---

<section class="hero" id="inicio">
  <div class="shell hero__grid">
    <div class="hero__text">
      <p class="hero__status rise" style="--d:80ms">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability}
      </p>

      <h1 class="hero__title">
        {
          lines.map((line, i) => (
            <span class="line-mask" style={`--d:${180 + i * 120}ms`}>
              <span class={i === lines.length - 1 ? 'accent' : undefined}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="lead hero__lead rise" style="--d:520ms">{profile.tagline}</p>

      <div class="hero__actions rise" style="--d:620ms">
        <Btn href="#projects" label="Ver proyectos" icon="down" />
        <Btn href={profile.cv} label="Descargar CV" icon="download" variant="ghost" external />
      </div>
    </div>

    <div class="hero__orb rise" style="--d:420ms">
      <Orb />
    </div>
  </div>

  <div class="shell">
    <ul class="metrics">
      {
        metrics.map((m, i) => (
          <li class="rise" style={`--d:${680 + i * 90}ms`}>
            <b class="mono-num">{m.value}</b>
            <span>{m.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 16vh, 11rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4em 0.95em 0.4em 0.75em;
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg-2) 62%, transparent);
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 550;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c2);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 70%, transparent);
    animation: pulse 2.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    60% {
      box-shadow: 0 0 0 9px color-mix(in oklab, var(--c2) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 0%, transparent);
    }
  }

  /* Archivo es bastante más ancha que la serif anterior: la escala y la
     medida están calculadas para que cada línea del titular quepa entera. */
  .hero__title {
    font-size: clamp(2.5rem, 6.1vw, 4.9rem);
    line-height: 0.94;
    letter-spacing: -0.042em;
    max-width: 21ch;
  }

  /* El titular entra solo al cargar, no espera al scroll */
  .hero__title .line-mask > span {
    transform: translateY(105%) rotate(2.4deg);
    animation: line-up 1.15s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line-mask > span {
      animation: none;
      transform: none;
    }
  }

  .hero__title .accent {
    color: var(--c1);
    font-style: italic;
    font-variation-settings: var(--display-fvs);
    padding-right: 0.08em;
  }

  .hero__lead {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
  }

  /* El campo de blobs se sale de su celda a propósito: encerrado en la
     columna se leía como "un objeto a la izquierda y otro a la derecha". */
  .hero__orb {
    justify-self: center;
    width: min(115%, 260px);
    margin-top: 0.5rem;
    overflow: visible;
  }

  /* Entrada al cargar: el héroe no espera al scroll */
  .rise {
    animation: rise-in 0.95s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }

  /* Cifras */
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .metrics li {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    padding: clamp(1rem, 2.4vw, 1.6rem) clamp(0.9rem, 2vw, 1.4rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.45s var(--ease-out);
  }
  .metrics li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .metrics li:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .metrics li:hover {
    background: var(--bg-2);
  }
  .metrics b {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.045em;
    font-variation-settings: var(--display-fvs);
  }
  .metrics li:nth-child(1) b {
    color: var(--c1);
  }
  .metrics li:nth-child(2) b {
    color: var(--c3);
  }
  .metrics li:nth-child(3) b {
    color: var(--c2);
  }
  .metrics li:nth-child(4) b {
    color: var(--c4);
  }
  .metrics span {
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.35;
  }

  @media (min-width: 720px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .metrics li {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .metrics li:last-child {
      border-right: 0;
    }
  }

  /* En tablet se apila bajo el texto; en escritorio pasa a su columna */
  @media (min-width: 560px) {
    .hero__orb {
      width: min(115%, 340px);
      margin-top: 1rem;
    }
  }

  @media (min-width: 1040px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    }
    .hero__orb {
      /* Invade el canal entre el texto y su columna, y respira hacia fuera */
      width: 152%;
      max-width: none;
      margin: 0 -13% 0 -32%;
      justify-self: stretch;
    }
  }
</style>
