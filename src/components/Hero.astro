---
import { profile, metrics } from '@/config/site';
import Seal from '@/components/Seal.astro';

const lines = profile.headline.split(' / ');
---

<section class="hero" id="inicio">
  <div class="shell hero__grid">
    <div class="hero__text">
      <p class="hero__status rise" style="--d:80ms">
        <span class="dot" aria-hidden="true"></span>
        {profile.availability} · {profile.location}
      </p>

      <h1 class="hero__title">
        {
          lines.map((line, i) => (
            <span class="line-mask" style={`--d:${180 + i * 120}ms`}>
              <span class={i === lines.length - 1 ? 'accent' : undefined}>{line}</span>
            </span>
          ))
        }
      </h1>

      <p class="lead hero__lead rise" style="--d:520ms">{profile.tagline}</p>

      <div class="hero__actions rise" style="--d:620ms">
        <a class="btn" href="#projects" data-magnetic>
          Ver proyectos
          <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              d="M8 2.6v10.8M3.4 9 8 13.6 12.6 9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn--ghost" href={profile.cv} target="_blank" rel="noreferrer" data-magnetic>
          Descargar CV
          <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
            <path
              d="M2.6 10.4v2.2a1 1 0 0 0 1 1h8.8a1 1 0 0 0 1-1v-2.2M8 2.4v8M4.8 7.2 8 10.4l3.2-3.2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="hero__seal rise" style="--d:420ms">
      <Seal />
    </div>
  </div>

  <div class="shell">
    <ul class="metrics">
      {
        metrics.map((m, i) => (
          <li class="rise" style={`--d:${680 + i * 90}ms`}>
            <b class="mono-num">{m.value}</b>
            <span>{m.label}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <a class="scroll-hint" href="#about" aria-label="Bajar al perfil">
    <span class="scroll-hint__line" aria-hidden="true"></span>
    <span class="scroll-hint__txt">scroll</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 16vh, 11rem);
    padding-bottom: clamp(2.5rem, 6vw, 5rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4em 0.95em 0.4em 0.75em;
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg-2) 62%, transparent);
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 550;
    letter-spacing: 0.03em;
    color: var(--ink-2);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c2);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 70%, transparent);
    animation: pulse 2.6s var(--ease-out) infinite;
  }
  @keyframes pulse {
    60% {
      box-shadow: 0 0 0 9px color-mix(in oklab, var(--c2) 0%, transparent);
    }
    100% {
      box-shadow: 0 0 0 0 color-mix(in oklab, var(--c2) 0%, transparent);
    }
  }

  .hero__title {
    font-size: clamp(2.9rem, 8.6vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: -0.042em;
    max-width: 15ch;
  }

  /* El titular entra solo al cargar, no espera al scroll */
  .hero__title .line-mask > span {
    transform: translateY(105%) rotate(2.4deg);
    animation: line-up 1.15s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes line-up {
    to {
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__title .line-mask > span {
      animation: none;
      transform: none;
    }
  }

  .hero__title .accent {
    color: var(--c1);
    font-style: italic;
    font-variation-settings: 'opsz' 100, 'SOFT' 100, 'WONK' 1;
    padding-right: 0.08em;
  }

  .hero__lead {
    margin-top: clamp(1.4rem, 3vw, 2rem);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.8rem, 4vw, 2.6rem);
  }

  .hero__seal {
    display: none;
    justify-self: center;
  }

  /* Entrada al cargar: el héroe no espera al scroll */
  .rise {
    animation: rise-in 0.95s var(--ease-out) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translate3d(0, 22px, 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise {
      animation: none;
    }
  }

  /* Cifras */
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .metrics li {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    padding: clamp(1rem, 2.4vw, 1.6rem) clamp(0.9rem, 2vw, 1.4rem);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.45s var(--ease-out);
  }
  .metrics li:nth-child(odd) {
    border-right: 1px solid var(--line);
  }
  .metrics li:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
  .metrics li:hover {
    background: var(--bg-2);
  }
  .metrics b {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variation-settings: 'opsz' 100, var(--wonk-on);
  }
  .metrics li:nth-child(1) b {
    color: var(--c1);
  }
  .metrics li:nth-child(2) b {
    color: var(--c3);
  }
  .metrics li:nth-child(3) b {
    color: var(--c2);
  }
  .metrics li:nth-child(4) b {
    color: var(--c4);
  }
  .metrics span {
    font-size: var(--step--1);
    color: var(--ink-3);
    line-height: 1.35;
  }

  /* Indicador de scroll.
     Vive en el margen exterior, fuera de .shell: si se ancla al borde inferior
     acaba encima de la última cifra. */
  .scroll-hint {
    position: absolute;
    right: max(0.5rem, calc((100% - var(--shell)) / 2 - 1.9rem));
    top: 50%;
    transform: translateY(-50%);
    display: none;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-alt);
    font-size: 0.66rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-3);
    writing-mode: vertical-rl;
  }
  .scroll-hint__line {
    display: block;
    width: 1px;
    height: 62px;
    background: var(--line-strong);
    overflow: hidden;
    position: relative;
  }
  .scroll-hint__line::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 40%;
    background: var(--c1);
    animation: trickle 2.4s var(--ease-io) infinite;
  }
  @keyframes trickle {
    0% {
      transform: translateY(-110%);
    }
    100% {
      transform: translateY(260%);
    }
  }

  @media (min-width: 720px) {
    .metrics {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .metrics li {
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .metrics li:last-child {
      border-right: 0;
    }
  }

  @media (min-width: 900px) {
    .scroll-hint {
      display: flex;
    }
  }

  /* En tablet el sello se apila bajo el texto; en escritorio pasa a su columna */
  @media (min-width: 760px) {
    .hero__seal {
      display: block;
      width: min(100%, 250px);
      margin-top: 1rem;
    }
  }

  @media (min-width: 1040px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    }
    .hero__seal {
      width: 100%;
      margin-top: 0;
    }
  }
</style>
