---
/**
 * Escena de Plateo: el teléfono y el panel de cocina, en paralelo.
 *
 * Es la historia del producto en catorce segundos: el cliente escribe, el
 * agente responde, y en cuanto se confirma el pedido la comanda aterriza
 * estructurada en el panel. Todo es CSS: no hay ni un GIF ni un vídeo.
 *
 * CÓMO ESTÁ SINCRONIZADO
 * Cada pieza usa la MISMA duración (--loop) y se separa con
 * `animation-delay`. El retardo solo se aplica a la primera vuelta, pero como
 * todas comparten duración, el desfase relativo se mantiene para siempre. Si
 * cambias --loop, cámbiala en todas: con duraciones distintas la escena se
 * desincroniza a los pocos ciclos.
 *
 * Medidas en `em`, nunca en px: el escenario fija el `font-size` en `cqw`.
 */
---

<div class="pl" data-scene-root>
  <div class="pl__glow"></div>
  <div class="pl__grid"></div>

  <!-- ── Panel de cocina ─────────────────────────────────────────────── -->
  <div class="pl__panel">
    <div class="pn__bar">
      <img class="pn__logo" src="/LogoPlateo.svg" alt="" width="593" height="576" />
      <span class="pn__name">Panel de cocina</span>
      <span class="pn__live"><i></i>en vivo</span>
    </div>

    <div class="pn__body">
      <div class="pn__stats">
        <div class="pn__stat">
          <b class="reel"
            ><span class="reel__strip"><span>126</span><span>127</span><span>128</span></span></b
          >
          <em>pedidos hoy</em>
        </div>
        <div class="pn__stat">
          <b>11:42</b>
          <em>tiempo medio</em>
        </div>
        <div class="pn__stat pn__stat--ok">
          <b>0</b>
          <em>sin atender</em>
        </div>
      </div>

      <div class="pn__ticket">
        <div class="tk__top">
          <span class="tk__id">#128</span>
          <span class="tk__chip">
            <span class="tk__chip-a">Recibido</span>
            <span class="tk__chip-b">En horno</span>
          </span>
        </div>
        <p class="tk__item">Napolitana grande · 2 gaseosas</p>
        <ul class="tk__mods">
          <li>sin cebolla</li>
          <li>borde de queso</li>
        </ul>
        <div class="tk__foot">
          <span>Pago confirmado</span>
          <b>$64.000</b>
        </div>
      </div>

      <div class="pn__old">
        <span>#127 · Margarita mediana</span><b>Entregado</b>
      </div>
      <div class="pn__old">
        <span>#126 · Combo familiar</span><b>Entregado</b>
      </div>
    </div>
  </div>

  <div class="pl__hand">
    <span class="hd__ico">JC</span>
    <div class="hd__txt">
      <b>Traspaso a humano</b>
      <em>El operador entra al chat sin que el cliente note la costura</em>
    </div>
    <span class="hd__sw"><i></i></span>
  </div>

  <!-- ── Teléfono ────────────────────────────────────────────────────── -->
  <div class="pl__phone">
    <div class="ph__screen">
      <div class="ph__bar">
        <span class="ph__av">PV</span>
        <span class="ph__who">
          <b>Pizzería Vesuvio</b>
          <em>en línea · responde al instante</em>
        </span>
      </div>

      <div class="ph__log">
        <span class="ph__day">Hoy · 19:42</span>
        <div class="b b--me" style="--d:0.5s">Una napolitana grande y dos gaseosas</div>
        <div class="b b--bot" style="--d:2.1s">Van $58.000. ¿Le agrego borde de queso por $6.000?</div>
        <div class="b b--me" style="--d:3.7s">Sí porfa, y sin cebolla</div>
        <div class="b b--bot" style="--d:5.1s">Anotado: sin cebolla. Total $64.000</div>
        <div class="b b--bot" style="--d:6.7s">Pago confirmado. Sale del horno en 25 min</div>

        <div class="b b--bot b--typing"><i></i><i></i><i></i></div>
      </div>

      <div class="ph__input"><span>Escribe un mensaje…</span><i></i></div>
    </div>
  </div>
</div>

<style>
  /* Paleta de marca de Plateo. No hereda del tema del sitio a propósito:
     la maqueta representa el producto real y debe verse igual en claro y en
     oscuro. */
  .pl {
    --mint: #15f5ba;
    --deep: #0b0730;
    --deep-2: #150c47;
    --bub: #2a1d6e;
    --paper: #fbfaff;
    --loop: 14s;

    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 78% 8%, #1a1053 0%, var(--deep) 62%);
    font-family: var(--font-sans);
  }

  .pl__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(38% 34% at 22% 62%, color-mix(in oklab, var(--mint) 34%, transparent), transparent 70%);
    filter: blur(2em);
  }

  .pl__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 4em 4em;
    mask-image: radial-gradient(80% 70% at 50% 40%, #000, transparent 78%);
  }

  /* ── Panel ──────────────────────────────────────────────────────────── */
  .pl__panel {
    position: absolute;
    left: 14.6em;
    top: 6.6em;
    width: 35.6em;
    border-radius: 1.1em;
    background: var(--paper);
    color: #17123a;
    box-shadow: 0 1.4em 3.4em -1.2em rgb(0 0 0 / 0.6);
    overflow: hidden;
    animation: pl-float 11s var(--ease-io) infinite alternate;
  }

  .pn__bar {
    display: flex;
    align-items: center;
    gap: 0.6em;
    /* Mismo margen izquierdo que .pn__body: por delante está el teléfono. */
    padding: 0.6em 0.9em 0.6em 4.2em;
    background: var(--deep-2);
    color: #fff;
  }
  .pn__logo {
    width: 1.5em;
    height: 1.5em;
    object-fit: contain;
  }
  .pn__name {
    font-size: 0.72em;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .pn__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-left: auto;
    font-size: 0.6em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mint);
  }
  .pn__live i {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--mint);
    animation: pl-pulse 2.2s var(--ease-io) infinite;
  }

  .pn__body {
    display: grid;
    gap: 0.55em;
    padding: 0.9em;
    /* El teléfono se apoya sobre el borde izquierdo: el contenido arranca
       después para que no quede nada tapado. */
    padding-left: 4.2em;
  }

  .pn__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6em;
  }
  .pn__stat {
    padding: 0.5em 0.7em;
    border-radius: 0.6em;
    background: #f0eefa;
  }
  .pn__stat--ok {
    background: color-mix(in oklab, var(--mint) 22%, #f0eefa);
  }
  .pn__stat b {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15em;
    font-weight: 680;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .pn__stat em {
    font-size: 0.56em;
    font-style: normal;
    color: #6a648c;
  }

  /* Contador: una tira de tres cifras que sube al aterrizar la comanda.
     Lo que se mueve es la tira interior, no la caja: animar la caja
     desplazaría la cifra entera fuera de su hueco. */
  .reel {
    height: 1em;
    overflow: hidden;
  }
  .reel__strip {
    display: block;
    animation: pl-reel var(--loop) steps(1, end) 7.9s infinite both;
  }
  .reel__strip span {
    display: block;
    height: 1em;
  }

  .pn__ticket {
    position: relative;
    padding: 0.75em 0.9em;
    border-radius: 0.7em;
    border: 1px solid color-mix(in oklab, var(--mint) 55%, transparent);
    background: #fff;
    box-shadow: 0 0.5em 1.4em -0.6em rgb(21 20 70 / 0.35);
    animation: pl-ticket var(--loop) var(--ease-out) 7.6s infinite both;
  }
  .pn__ticket::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid var(--mint);
    animation: pl-ring var(--loop) var(--ease-out) 7.6s infinite both;
  }

  .tk__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .tk__id {
    font-family: var(--font-alt);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #6a648c;
  }
  .tk__chip {
    position: relative;
    display: grid;
    padding: 0.22em 0.6em;
    border-radius: 999px;
    font-size: 0.58em;
    font-weight: 600;
    background: color-mix(in oklab, var(--mint) 26%, #fff);
  }
  .tk__chip > span {
    grid-area: 1 / 1;
  }
  .tk__chip-a {
    animation: pl-chip-a var(--loop) linear 7.6s infinite both;
  }
  .tk__chip-b {
    animation: pl-chip-b var(--loop) linear 7.6s infinite both;
  }

  .tk__item {
    margin-top: 0.25em;
    font-size: 0.78em;
    font-weight: 600;
  }
  .tk__mods {
    display: flex;
    gap: 0.35em;
    margin-top: 0.35em;
    list-style: none;
    padding: 0;
  }
  .tk__mods li {
    padding: 0.16em 0.5em;
    border-radius: 0.4em;
    font-size: 0.56em;
    background: #efedf9;
    color: #55507a;
  }
  .tk__foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.55em;
    padding-top: 0.45em;
    border-top: 1px dashed #e0ddef;
    font-size: 0.6em;
    color: #6a648c;
  }
  .tk__foot b {
    font-family: var(--font-display);
    font-size: 1.35em;
    font-weight: 680;
    letter-spacing: -0.03em;
    color: #17123a;
  }

  .pn__old {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4em 0.7em;
    border-radius: 0.5em;
    background: #f4f2fb;
    font-size: 0.6em;
    color: #8a85a8;
  }
  .pn__old b {
    font-weight: 600;
    color: #6a648c;
  }

  /* ── Traspaso ───────────────────────────────────────────────────────── */
  .pl__hand {
    position: absolute;
    left: 18em;
    top: 28.4em;
    display: flex;
    align-items: center;
    gap: 0.9em;
    width: 31.6em;
    padding: 0.85em 1.1em;
    border-radius: 0.9em;
    border: 1px solid rgb(255 255 255 / 0.13);
    background: rgb(255 255 255 / 0.07);
    backdrop-filter: blur(0.6em);
    color: #e7e3ff;
    animation: pl-float 15s var(--ease-io) infinite alternate;
  }
  .hd__ico {
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border-radius: 50%;
    background: color-mix(in oklab, var(--mint) 24%, transparent);
    border: 1px solid color-mix(in oklab, var(--mint) 45%, transparent);
    color: var(--mint);
    font-size: 0.62em;
    font-weight: 700;
  }
  .hd__txt b {
    display: block;
    font-size: 0.7em;
    font-weight: 600;
  }
  .hd__txt em {
    display: block;
    font-size: 0.58em;
    font-style: normal;
    color: #9d94d6;
  }
  .hd__sw {
    display: flex;
    align-items: center;
    margin-left: auto;
    width: 2.2em;
    height: 1.2em;
    padding: 0.16em;
    border-radius: 999px;
    background: var(--mint);
  }
  .hd__sw i {
    width: 0.88em;
    height: 0.88em;
    margin-left: auto;
    border-radius: 50%;
    background: var(--deep);
  }

  /* ── Teléfono ───────────────────────────────────────────────────────── */
  .pl__phone {
    position: absolute;
    left: 1.1em;
    top: 3.4em;
    width: 15.4em;
    height: 33.4em;
    padding: 0.42em;
    border-radius: 2.2em;
    background: linear-gradient(150deg, #3a3170, #100b32 46%, #2a2258);
    box-shadow: 0 2em 4em -1.2em rgb(0 0 0 / 0.75), inset 0 0 0 1px rgb(255 255 255 / 0.14);
    animation: pl-float 13s var(--ease-io) infinite alternate-reverse;
  }

  .ph__screen {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    border-radius: 1.85em;
    background: linear-gradient(180deg, #150d40, #0d0830);
    overflow: hidden;
  }

  .ph__bar {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.75em 0.7em 0.6em;
    background: rgb(255 255 255 / 0.06);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .ph__av {
    display: grid;
    place-items: center;
    width: 1.8em;
    height: 1.8em;
    border-radius: 50%;
    background: var(--mint);
    color: var(--deep);
    font-size: 0.62em;
    font-weight: 700;
  }
  .ph__who {
    display: grid;
  }
  .ph__who b {
    font-size: 0.66em;
    font-weight: 600;
    color: #fff;
  }
  .ph__who em {
    font-size: 0.52em;
    font-style: normal;
    color: color-mix(in oklab, var(--mint) 80%, #fff);
  }

  .ph__log {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.42em;
    padding: 0.7em;
    overflow: hidden;
  }

  .ph__day {
    align-self: center;
    margin-bottom: 0.2em;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.07);
    font-size: 0.52em;
    color: #8f86c9;
  }

  .b {
    max-width: 82%;
    padding: 0.42em 0.6em;
    border-radius: 0.85em;
    font-size: 0.66em;
    line-height: 1.4;
    animation: pl-bubble var(--loop) var(--ease-out) var(--d) infinite both;
  }
  .b--me {
    align-self: flex-end;
    border-bottom-right-radius: 0.25em;
    background: var(--mint);
    color: #06251d;
    font-weight: 500;
  }
  .b--bot {
    align-self: flex-start;
    border-bottom-left-radius: 0.25em;
    background: var(--bub);
    color: #e7e3ff;
  }

  /* Absoluto: si ocupara sitio en la columna, su hueco seguiría ahí durante
     los doce segundos en los que no se ve. */
  .b--typing {
    position: absolute;
    left: 0.7em;
    bottom: 0.7em;
    display: flex;
    gap: 0.28em;
    padding: 0.62em 0.7em;
    animation: pl-typing var(--loop) var(--ease-out) infinite both;
  }
  .b--typing i {
    width: 0.34em;
    height: 0.34em;
    border-radius: 50%;
    background: #9d92e8;
    animation: pl-dot 1.1s var(--ease-io) infinite;
  }
  .b--typing i:nth-child(2) {
    animation-delay: 0.16s;
  }
  .b--typing i:nth-child(3) {
    animation-delay: 0.32s;
  }

  .ph__input {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0.5em;
    padding: 0.34em 0.5em;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.08);
    font-size: 0.62em;
    color: #8f86c9;
  }
  .ph__input i {
    width: 0.9em;
    height: 0.9em;
    margin-left: auto;
    border-radius: 50%;
    background: var(--mint);
  }

  /* ── Animaciones ────────────────────────────────────────────────────── */
  @keyframes pl-bubble {
    0% {
      opacity: 0;
      transform: translateY(0.7em) scale(0.94);
    }
    3%,
    82% {
      opacity: 1;
      transform: none;
    }
    88%,
    100% {
      opacity: 0;
      transform: translateY(-0.35em) scale(0.98);
    }
  }

  @keyframes pl-typing {
    0%,
    7% {
      opacity: 0;
      transform: translateY(0.5em);
    }
    8.5%,
    13.5% {
      opacity: 1;
      transform: none;
    }
    15%,
    29% {
      opacity: 0;
      transform: translateY(0.5em);
    }
    30.5%,
    34.5% {
      opacity: 1;
      transform: none;
    }
    36%,
    100% {
      opacity: 0;
      transform: translateY(0.5em);
    }
  }

  @keyframes pl-dot {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    40% {
      transform: translateY(-0.28em);
      opacity: 1;
    }
  }

  @keyframes pl-ticket {
    0% {
      opacity: 0;
      transform: translateX(1.8em) scale(0.96);
    }
    4%,
    84% {
      opacity: 1;
      transform: none;
    }
    90%,
    100% {
      opacity: 0;
      transform: translateY(-0.4em);
    }
  }

  @keyframes pl-ring {
    0%,
    3% {
      opacity: 0;
      transform: scale(1);
    }
    5% {
      opacity: 1;
    }
    14%,
    100% {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes pl-chip-a {
    0%,
    11% {
      opacity: 1;
    }
    13%,
    100% {
      opacity: 0;
    }
  }
  @keyframes pl-chip-b {
    0%,
    11% {
      opacity: 0;
    }
    13%,
    100% {
      opacity: 1;
    }
  }

  @keyframes pl-reel {
    0% {
      transform: translateY(0);
    }
    2% {
      transform: translateY(-33.333%);
    }
    4%,
    100% {
      transform: translateY(-66.666%);
    }
  }

  @keyframes pl-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.8);
    }
    50% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes pl-float {
    to {
      transform: translateY(-0.8em);
    }
  }

  /* Fuera de pantalla no se anima nada: cuatro escenas a la vez cuestan. */
  .pl *,
  .pl {
    animation-play-state: paused;
  }
  .pl[data-live],
  .pl[data-live] * {
    animation-play-state: running;
  }

  @media (prefers-reduced-motion: reduce) {
    .pl[data-live],
    .pl[data-live] * {
      animation: none !important;
    }
    /* Sin movimiento la escena se queda en su estado final: la conversación
       completa y la comanda ya en el panel. */
    .b,
    .pn__ticket,
    .tk__chip-b {
      opacity: 1;
    }
    .b--typing,
    .tk__chip-a,
    .pn__ticket::before {
      opacity: 0;
    }
    .reel__strip {
      transform: translateY(-66.666%);
    }
  }
</style>
