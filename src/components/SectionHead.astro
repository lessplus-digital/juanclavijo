---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  intro?: string;
  /** Alinea el bloque a la derecha en pantallas anchas */
  align?: 'start' | 'end';
  /** Quita el margen inferior: para cuando el encabezado va dentro de una retícula */
  flush?: boolean;
}
const { index, eyebrow, title, intro, align = 'start', flush = false } = Astro.props;
---

<header class:list={['head', flush && 'head--flush']} data-align={align}>
  <div class="head__meta" data-reveal>
    <span class="head__index mono-num">{index}</span>
    <span class="head__line" aria-hidden="true"></span>
    <span class="eyebrow">{eyebrow}</span>
  </div>

  <h2 class="head__title" data-reveal style="--d:90ms">{title}</h2>

  {intro && <p class="head__intro" data-reveal style="--d:170ms">{intro}</p>}
</header>

<style>
  /* Sin ancho fijo en el contenedor: cada pieza se limita sola. Con un
     max-width en ch sobre .head, el título heredaba una medida calculada con
     el cuerpo de texto y rompía en tres líneas con huérfanas. */
  .head {
    margin-bottom: clamp(2.4rem, 5vw, 4rem);
    max-width: 34ch;
  }
  .head--flush {
    margin-bottom: 0;
  }
  .head[data-align='end'] {
    margin-inline-start: auto;
    width: fit-content;
  }

  .head__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: clamp(0.9rem, 2vw, 1.3rem);
  }

  .head__index {
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--c1);
  }

  .head__line {
    width: clamp(28px, 6vw, 56px);
    height: 1px;
    background: var(--line-strong);
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.9s var(--ease-out) 0.15s;
  }
  .head__meta.is-in .head__line {
    transform: scaleX(1);
  }

  /* Medida en em: se escala con el propio cuerpo del titular */
  .head__title {
    max-width: 13em;
  }

  .head__intro {
    margin-top: clamp(0.9rem, 2vw, 1.3rem);
    max-width: 44ch;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  @media (min-width: 900px) {
    .head {
      max-width: none;
    }
  }
</style>
