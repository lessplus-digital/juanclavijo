---
/**
 * Botón del sitio.
 * La etiqueta va duplicada: al pasar el ratón la primera copia sale por arriba
 * y la segunda entra por abajo. Es una animación de composición pura
 * (solo transform), así que va suave incluso en móviles.
 */
interface Props {
  href: string;
  label: string;
  variant?: 'solid' | 'ghost';
  icon?: 'arrow' | 'down' | 'download' | 'none';
  external?: boolean;
  class?: string;
}

const {
  href,
  label,
  variant = 'solid',
  icon = 'arrow',
  external = false,
  class: cls,
} = Astro.props;

const paths = {
  arrow: 'M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9',
  down: 'M8 2.6v10.8M3.4 9 8 13.6 12.6 9',
  download: 'M2.6 10.4v2.2a1 1 0 0 0 1 1h8.8a1 1 0 0 0 1-1v-2.2M8 2.4v8M4.8 7.2 8 10.4l3.2-3.2',
};
---

<a
  class:list={['btn', variant === 'ghost' && 'btn--ghost', cls]}
  href={href}
  data-icon={icon}
  {...external ? { target: '_blank', rel: 'noreferrer' } : {}}
>
  <span class="btn__label">
    <span class="btn__t">{label}</span>
    <span class="btn__t" aria-hidden="true">{label}</span>
  </span>

  {
    icon !== 'none' && (
      <svg class="btn__icon" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
        <path
          d={paths[icon]}
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
