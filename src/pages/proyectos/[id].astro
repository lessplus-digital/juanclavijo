---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '@/layouts/Base.astro';
import ProjectArt from '@/components/ProjectArt.astro';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      index: i,
      next: projects[(i + 1) % projects.length],
    },
  }));
}) satisfies GetStaticPaths;

const { project, index, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const hasNext = next && next.id !== project.id;
---

<Base title={`${p.title} — Juan Clavijo`} description={p.summary} compactNav>
  <article class="case" style={`--accent: var(--${p.accent})`}>
    <header class="case__head">
      <div class="shell">
        <a class="case__back link-u" href="/#projects">
          <span aria-hidden="true">←</span> Volver al portafolio
        </a>

        <p class="case__kicker" data-reveal>{p.kicker}</p>

        <h1 class="case__title">
          <span class="line-mask"><span>{p.title}</span></span>
        </h1>

        <p class="lead case__summary" data-reveal style="--d:220ms">{p.summary}</p>

        <dl class="case__meta" data-reveal style="--d:300ms">
          <div>
            <dt>Papel</dt>
            <dd>{p.role}</dd>
          </div>
          <div>
            <dt>Año</dt>
            <dd>{p.year}</dd>
          </div>
          <div>
            <dt>Stack</dt>
            <dd>{p.tags.join(' · ')}</dd>
          </div>
          {
            p.url && (
              <div>
                <dt>En vivo</dt>
                <dd>
                  <a class="link-u" href={p.url} target="_blank" rel="noreferrer">
                    {p.urlLabel ?? p.url.replace(/^https?:\/\//, '')} ↗
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="shell">
      <div class="case__art" data-reveal="scale">
        {
          p.cover ? (
            <img src={p.cover} alt={`Vista de ${p.title}`} width="1600" height="900" />
          ) : (
            <ProjectArt variant={index} />
          )
        }
      </div>

      {
        p.metrics.length > 0 && (
          <ul class="case__metrics">
            {p.metrics.map((m, i) => (
              <li data-reveal style={`--d:${i * 90}ms`}>
                <b class="mono-num">{m.value}</b>
                <span>{m.label}</span>
              </li>
            ))}
          </ul>
        )
      }

      <div class="prose" data-reveal>
        <Content />
      </div>

      {
        p.url && (
          <p class="case__cta" data-reveal>
            <a class="btn" href={p.url} target="_blank" rel="noreferrer" data-magnetic>
              Visitar {p.urlLabel ?? p.title}
              <svg class="arrow" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
                <path
                  d="M3.5 12.5 12.5 3.5M5.6 3.5h6.9v6.9"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          </p>
        )
      }
    </div>

    {
      hasNext && (
        <nav class="nextp" aria-label="Siguiente proyecto">
          <a class="shell nextp__link" href={`/proyectos/${next.id}/`}>
            <span class="eyebrow">Siguiente proyecto</span>
            <span class="nextp__title">{next.data.title}</span>
            <span class="nextp__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .case__head {
    padding-top: clamp(7rem, 15vh, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3.4rem);
  }

  .case__back {
    display: inline-block;
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: clamp(1.6rem, 4vw, 2.6rem);
  }

  .case__kicker {
    font-family: var(--font-alt);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }

  .case__title {
    font-size: clamp(2.8rem, 10vw, 6.4rem);
    letter-spacing: -0.045em;
  }
  .case__title .line-mask > span {
    transform: translateY(105%) rotate(2deg);
    animation: case-up 1.1s var(--ease-out) 0.1s both;
  }
  @keyframes case-up {
    to {
      transform: none;
    }
  }

  .case__summary {
    margin-top: clamp(1.2rem, 3vw, 1.8rem);
    max-width: 54ch;
  }

  .case__meta {
    display: grid;
    gap: 1px;
    margin-top: clamp(2rem, 4vw, 3rem);
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  .case__meta > div {
    display: grid;
    gap: 0.2rem;
    padding: 1rem 0.1rem;
    background: var(--bg);
  }
  .case__meta dt {
    font-family: var(--font-alt);
    font-size: var(--step--2);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .case__meta dd {
    margin: 0;
    font-size: var(--step--1);
    max-width: 30ch;
  }

  .case__art {
    position: relative;
    aspect-ratio: 16 / 8;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--accent) 10%, var(--bg-3));
    overflow: hidden;
  }
  .case__art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: clamp(1.2rem, 3vw, 2.4rem);
    margin-top: clamp(2rem, 4vw, 3.2rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
  }
  .case__metrics b {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--accent);
    font-variation-settings: 'opsz' 100, var(--wonk-on);
  }
  .case__metrics span {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--ink-3);
    max-width: 22ch;
  }

  .case__cta {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  /* Siguiente proyecto */
  .nextp {
    margin-top: clamp(3rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .nextp__link {
    display: grid;
    gap: 0.4rem;
    padding-block: clamp(2.4rem, 6vw, 4.5rem);
    position: relative;
  }
  .nextp__title {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: 500;
    letter-spacing: -0.04em;
    font-variation-settings: 'opsz' 100, var(--wonk-on);
    transition: color 0.45s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .nextp__link:hover .nextp__title {
    color: var(--c1);
    transform: translateX(10px);
  }
  .nextp__arrow {
    position: absolute;
    right: 0;
    bottom: clamp(2.4rem, 6vw, 4.5rem);
    font-size: var(--step-3);
    color: var(--ink-3);
    transition: transform 0.6s var(--ease-spring), color 0.4s var(--ease-out);
  }
  .nextp__link:hover .nextp__arrow {
    transform: translateX(12px);
    color: var(--c1);
  }

  @media (min-width: 700px) {
    .case__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .case__meta > div {
      padding-inline: 1.2rem;
    }
  }
  @media (min-width: 1000px) {
    .case__meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case__title .line-mask > span {
      animation: none;
      transform: none;
    }
  }
</style>

<style is:global>
  /* ── Texto largo del caso ─────────────────────────────────────────────── */
  .prose {
    max-width: 68ch;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
    font-size: var(--step-0);
    color: var(--ink-2);
  }
  .prose h2 {
    font-size: var(--step-3);
    color: var(--ink);
    margin-top: 2.4em;
    margin-bottom: 0.55em;
    letter-spacing: -0.035em;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .prose h3 {
    font-size: var(--step-1);
    color: var(--ink);
    margin-top: 1.9em;
    margin-bottom: 0.4em;
  }
  .prose p {
    margin-block: 1em;
  }
  .prose p:first-of-type {
    margin-top: 0;
  }
  .prose ul {
    display: grid;
    gap: 0.7em;
    margin-block: 1.3em;
  }
  .prose li {
    position: relative;
    padding-left: 1.5rem;
  }
  .prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 9px;
    height: 1.5px;
    background: var(--accent, var(--c1));
  }
  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--accent, var(--c1));
  }
  .prose code {
    font-family: var(--font-alt);
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    border-radius: 6px;
    background: var(--bg-3);
  }
</style>
