---
// Página temporal de verificación. Se borra al terminar.
import Base from '@/layouts/Base.astro';
import Stack from '@/components/sections/Stack.astro';
import { sections } from '@/config/site';
const section = sections.find((s) => s.id === 'stack')!;
---
<Base title="stack" description="prueba">
  <Stack section={section} />
</Base>
<script is:inline>
  const q = new URLSearchParams(location.search);
  if (q.has('dark')) document.documentElement.dataset.theme = 'dark';
  document.querySelectorAll('[data-reveal]').forEach((n) => n.classList.add('is-in'));
  document.querySelector('[data-field]')?.setAttribute('data-live', '');
</script>
